{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtj://page-builder/product-facts.schema.json",
  "title": "Product facts for the page builder",
  "description": "Everything the page may say. Every text-bearing fact names its SOURCE (product description, pack, client brief, ...). A section whose facts are missing is omitted. A source starting with SAMPLE marks sample content (Harsh, 10 Oct 2026): listed in the build report, allowed on draft themes only, replaced or signed off before live. 'demo': true allows test pictures on our own stores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["product"],
  "$defs": {
    "source": {"type": "string", "minLength": 2, "maxLength": 120},
    "role": {"type": "string", "pattern": "^[a-z0-9_]{2,30}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 400}
  },
  "properties": {
    "demo": {"type": "boolean"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 80}, "handle": {"type": "string"}}
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "file"],
        "properties": {"role": {"$ref": "#/$defs/role"}, "file": {"type": "string", "pattern": "^[^/\\\\]+\\.(png|jpg|jpeg|webp)$"}, "alt": {"type": "string"}}
      }
    },
    "trust_points": {"type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": {"text": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/source"}}}},
    "benefits": {"type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["title", "source"], "properties": {"title": {"$ref": "#/$defs/text"}, "text": {"type": "string", "maxLength": 400}, "icon": {"type": "string"}, "source": {"$ref": "#/$defs/source"}}}},
    "story": {"type": "object", "additionalProperties": false, "required": ["heading", "source"], "properties": {"heading": {"$ref": "#/$defs/text"}, "accent": {"type": "string"}, "body": {"type": "string", "maxLength": 400}, "bullets": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/text"}}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}},
    "steps": {"type": "object", "additionalProperties": false, "required": ["items", "source"], "properties": {"intro": {"type": "string", "maxLength": 400}, "items": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/text"}}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}},
    "key_facts": {"type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["value", "label", "source"], "properties": {"value": {"type": "string", "maxLength": 40}, "label": {"$ref": "#/$defs/text"}, "note": {"type": "string", "maxLength": 200}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}}},
    "pack_contents": {"type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["name", "source"], "properties": {"name": {"$ref": "#/$defs/text"}, "detail": {"type": "string"}, "dose": {"type": "string"}, "benefits": {"type": "array", "items": {"type": "string"}}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}}},
    "free_from": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["name", "source"], "properties": {"name": {"$ref": "#/$defs/text"}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}}},
    "comparison": {"type": "object", "additionalProperties": false, "required": ["rows", "source"], "properties": {"ours_label": {"type": "string"}, "other_label": {"type": "string"}, "rows": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["ours", "other"], "properties": {"ours": {"$ref": "#/$defs/text"}, "other": {"$ref": "#/$defs/text"}}}}, "image_role": {"$ref": "#/$defs/role"}, "claims_approved": {"type": "boolean"}, "source": {"$ref": "#/$defs/source"}}},
    "faqs": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["q", "a", "source"], "properties": {"q": {"$ref": "#/$defs/text"}, "a": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/source"}}}},
    "reviews": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["quote", "name", "source"], "properties": {"quote": {"$ref": "#/$defs/text"}, "name": {"type": "string"}, "location": {"type": "string"}, "rating": {"type": "integer", "minimum": 1, "maximum": 5}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}, "person": {"enum": ["f", "m"], "description": "a SAMPLE person's gender, so DTJ's sample photo matches the name"}}}},
    "rating": {"type": "object", "additionalProperties": false, "required": ["value", "source"], "properties": {"value": {"type": "string", "pattern": "^[0-5](\\.[0-9])?$"}, "source": {"$ref": "#/$defs/source"}}},
    "guarantees": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": {"text": {"$ref": "#/$defs/text"}, "icon": {"type": "string"}, "source": {"$ref": "#/$defs/source"}}}},
    "buybox": {"type": "object", "additionalProperties": false, "properties": {"tagline": {"type": "string", "maxLength": 40}, "intro": {"type": "string", "maxLength": 200}, "bullets": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/text"}}, "source": {"$ref": "#/$defs/source"}}},
    "bundles": {"type": "object", "additionalProperties": false, "properties": {"addon_handles": {"type": "array", "maxItems": 4, "items": {"type": "string"}}, "variant_handles": {"type": "array", "maxItems": 8, "items": {"type": "string"}}}},
    "ugc": {"description": "W03: 3-6 customer or creator photos or videos (with permission), each a media role (the picture is the fallback when a video is set). Sample pictures allowed only with demo: true.", "type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["image_role", "source"], "properties": {"image_role": {"$ref": "#/$defs/role"}, "video": {"type": "string", "pattern": "^[^/\\\\]+\\.(mp4|mov|webm|m4v)$", "description": "a video in the store's Files (Content > Files): its file name"}, "caption": {"type": "string", "maxLength": 80}, "source": {"$ref": "#/$defs/source"}}}},
    "story_2": {"description": "W06: the second big benefit (picture right).", "type": "object", "additionalProperties": false, "required": ["heading", "source"], "properties": {"heading": {"$ref": "#/$defs/text"}, "accent": {"type": "string"}, "body": {"type": "string", "maxLength": 400}, "bullets": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/text"}}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}},
    "differentiators": {"description": "W08: why this and not the usual alternative: 4 or 6 cards. Never names a competitor.", "type": "object", "additionalProperties": false, "required": ["heading", "items", "source"], "properties": {"heading": {"$ref": "#/$defs/text"}, "highlight": {"type": "string", "maxLength": 40}, "items": {"type": "array", "minItems": 4, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["title", "source"], "properties": {"title": {"$ref": "#/$defs/text"}, "text": {"type": "string", "maxLength": 200}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}}}, "source": {"$ref": "#/$defs/source"}}},
    "strip_2": {"description": "W09: the second benefit strip, different items from trust_points.", "type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": {"text": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/source"}}}},
    "feature_intro": {"description": "W10: the headline and two sentences above the 4 benefits.", "type": "object", "additionalProperties": false, "required": ["heading", "source"], "properties": {"heading": {"$ref": "#/$defs/text"}, "text": {"type": "string", "maxLength": 300}, "source": {"$ref": "#/$defs/source"}}},
    "guarantee": {"description": "W11: the money-back / satisfaction promise with its real terms (or SAMPLE days).", "type": "object", "additionalProperties": false, "required": ["heading", "source"], "properties": {"heading": {"$ref": "#/$defs/text"}, "text": {"type": "string", "maxLength": 400}, "seal": {"type": "string", "maxLength": 40}, "source": {"$ref": "#/$defs/source"}}},
    "stories": {"description": "W14: 3-6 customer stories (photo, name, tags, quote), different people from the reviews.", "type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["name", "quote", "source"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 60}, "quote": {"$ref": "#/$defs/text"}, "tags": {"type": "string", "maxLength": 80}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}, "person": {"enum": ["f", "m"], "description": "a SAMPLE person's gender, so DTJ's sample photo matches the name"}}}},
    "final_push": {"description": "W15: the last band: picture, the final value proposition, one sentence, the button.", "type": "object", "additionalProperties": false, "required": ["heading", "source"], "properties": {"heading": {"$ref": "#/$defs/text"}, "text": {"type": "string", "maxLength": 300}, "image_role": {"$ref": "#/$defs/role"}, "source": {"$ref": "#/$defs/source"}}},
    "cta": {"description": "The page's ONE call-to-action label and what it does (scroll to the buy box, or add the only variant to the cart).", "type": "object", "additionalProperties": false, "required": ["label", "source"], "properties": {"label": {"type": "string", "minLength": 2, "maxLength": 30}, "action": {"enum": ["scroll", "cart"]}, "source": {"$ref": "#/$defs/source"}}},
    "social_proof": {"description": "The line above the title: a badge and up to 2 short lines (sourced facts), and photos ONLY of real customers who agreed (consent = where that agreement is recorded).", "type": "object", "additionalProperties": false, "properties": {"lines": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 60}, "source": {"$ref": "#/$defs/source"}}}}, "badge": {"type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 40}, "source": {"$ref": "#/$defs/source"}}}, "avatars": {"type": "array", "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["role", "consent"], "properties": {"role": {"$ref": "#/$defs/role"}, "consent": {"type": "string", "minLength": 5, "maxLength": 200}}}}}}
  }
}
