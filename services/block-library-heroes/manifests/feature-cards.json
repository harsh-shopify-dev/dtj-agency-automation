    {
      "type": "header",
      "content": "Picture and layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Centre picture"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture shape",
      "default": "0.75",
      "options": [
        {
          "value": "0.75",
          "label": "Portrait 3:4"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        },
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "1.3333",
          "label": "Landscape 4:3"
        }
      ],
      "info": "Width divided by height."
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Picture width on desktop",
      "min": 260,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Picture corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Space between columns on desktop",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text inside the cards",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centred"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_columns",
