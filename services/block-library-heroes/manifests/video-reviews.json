    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Card 1: picture",
      "info": "A tall picture works best. Empty = the video's own still frame."
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Card 1: video",
      "info": "Optional. Only loads when a visitor presses play."
    },
    {
      "type": "text",
      "id": "name_1",
      "label": "Card 1: name"
    },
    {
      "type": "text",
