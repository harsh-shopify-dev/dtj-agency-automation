    {
      "type": "header",
      "content": "Picture and layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Picture side on desktop",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "select",
      "id": "split",
      "label": "Column widths (text : picture)",
      "default": "1fr 1fr",
      "options": [
        {
          "value": "1fr 1fr",
          "label": "Equal"
        },
        {
          "value": "6fr 5fr",
          "label": "More text"
        },
        {
          "value": "5fr 6fr",
          "label": "More picture"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture shape on phones",
      "default": "1.25",
      "options": [
        {
          "value": "1.25",
          "label": "Landscape 5:4"
        },
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        },
        {
          "value": "1.7778",
          "label": "Wide 16:9"
        }
      ],
      "info": "Width divided by height. On desktop the picture fills the height of the text column."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Picture focus",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Which part stays in view when the picture is cropped."
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Picture corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Space between the columns",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "tile_columns",
      "label": "Tiles per row on desktop",
      "default": "3",
      "options": [
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ]
    },
    {
      "type": "select",
      "id": "tile_columns_mobile",
      "label": "Tiles per row on phones",
      "default": "2",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        },
        {
          "value": "1",
          "label": "One"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image",
      "label": "Picture on phones",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Above the text"
        },
        {
          "value": "bottom",
          "label": "Below the text"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "This section is at the top of the page",
      "default": false,
      "info": "Loads the picture first. Leave off for a section further down."
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "The default for the icon circles and the tile tint. Empty = the text color."
