deo_5","label":"Card 5: video"},{"type":"text","id":"name_5","label":"Card 5: name"},{"type":"text","id":"text_5","label":"Card 5: line under the name"},{"type":"url","id":"url_5","label":"Card 5: link"},{"type":"image_picker","id":"image_6","label":"Card 6: picture"},{"type":"video","id":"video_6","label":"Card 6: video"},{"type":"text","id":"name_6","label":"Card 6: name"},{"type":"text","id":"text_6","label":"Card 6: line under the name"},{"type":"url","id":"url_6","label":"Card 6: link"},{"type":"header","content":"Look"},{"type":"select","id":"card_ratio","label":"Card shape","default":"1.7778","options":[{"value":"1.7778","label":"Tall 9:16"},{"value":"1.3333","label":"Portrait 3:4"},{"value":"1.25","label":"Portrait 4:5"},{"value":"1","label":"Square"}]},{"type":"range","id":"card_size","label":"Card size on desktop","min":14,"max":26,"step":1,"unit":"%","default":21,"info":"Width of the centre card as a share of the carousel."},{"type":"range","id":"mobile_card_size","label":"Card size on phones","min":50,"max":80,"step":1,"unit":"%","default":64,"info":"The neighbours peek in from the sides."},{"type":"select","id":"visible_desktop","label":"Cards in view on desktop","default":"5","options":[{"value":"5","label":"Five (centre, two each side)"},{"value":"3","label":"Three (centre, one each side)"}]},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"container_width","label":"Maximum width","min":800,"max":1920,"step":20,"unit":"px","default":1500},{"type":"range","id":"shade","label":"Dark fade behind the text","min":0,"max":100,"step":5,"unit":"%","default":70,"info":"Keeps the name readable on a bright picture."},{"type":"range","id":"outer_fade","label":"Fade of the outer cards","min":0,"max":80,"step":5,"unit":"%","default":45},{"type":"color","id":"caption_color","label":"Card text color","info":"Empty = white."},{"type":"color","id":"verified_color","label":"Verified tick color"},{"type":"color","id":"link_color","label":"Card link color"},{"type":"select","id":"play_style","label":"Play button","default":"outline","options":[{"value":"outline","label":"Outline"},{"value":"solid","label":"Solid"}]},{"type":"range","id":"heading_size_desktop","label":"Heading size, desktop","min":24,"max":64,"step":1,"unit":"px","default":40},{"type":"range","id":"heading_size_mobile","label":"Heading size, phones","min":20,"max":40,"step":1,"unit":"px","default":26},{"type":"header","content":"Arrows and motion"},{"type":"select","id":"arrows","label":"Arrows","default":"sides","options":[{"value":"sides","label":"Arrows at both sides"},{"value":"none","label":"No arrows (swipe only)"}]},{"type":"checkbox","id":"arrows_mobile","label":"Show arrows on phones too","default":false},{"type":"color","id":"arrow_bg","label":"Arrow color"},{"type":"color","id":"arrow_color","label":"Arrow icon color"},{"type":"checkbox","id":"autoplay","label":"Move to the next card by itself","default":false,"info":"Only while the carousel is on screen, never while a video plays, never for visitors who prefer less motion."},{"type":"range","id":"autoplay_seconds","label":"Seconds per card","min":3,"max":12,"step":1,"unit":"s","default":5},{"type":"checkbox","id":"priority","label":"This carousel is at the top of the page","default":false,"info":"Loads the centre picture first. Leave off for a section further down: it then loads only when scrolled near."},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":0},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Backg