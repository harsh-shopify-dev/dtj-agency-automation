e":"image_picker","id":"photo_3","label":"Card 3 photo"},{"type":"text","id":"tag_3_1","label":"Card 3 tag 1"},{"type":"text","id":"tag_3_2","label":"Card 3 tag 2"},{"type":"text","id":"tag_3_3","label":"Card 3 tag 3"},{"type":"textarea","id":"quote_3","label":"Card 3 quote"},{"type":"text","id":"name_4","label":"Card 4 name"},{"type":"image_picker","id":"photo_4","label":"Card 4 photo"},{"type":"text","id":"tag_4_1","label":"Card 4 tag 1"},{"type":"text","id":"tag_4_2","label":"Card 4 tag 2"},{"type":"text","id":"tag_4_3","label":"Card 4 tag 3"},{"type":"textarea","id":"quote_4","label":"Card 4 quote"},{"type":"text","id":"name_5","label":"Card 5 name"},{"type":"image_picker","id":"photo_5","label":"Card 5 photo"},{"type":"text","id":"tag_5_1","label":"Card 5 tag 1"},{"type":"text","id":"tag_5_2","label":"Card 5 tag 2"},{"type":"text","id":"tag_5_3","label":"Card 5 tag 3"},{"type":"textarea","id":"quote_5","label":"Card 5 quote"},{"type":"text","id":"name_6","label":"Card 6 name"},{"type":"image_picker","id":"photo_6","label":"Card 6 photo"},{"type":"text","id":"tag_6_1","label":"Card 6 tag 1"},{"type":"text","id":"tag_6_2","label":"Card 6 tag 2"},{"type":"text","id":"tag_6_3","label":"Card 6 tag 3"},{"type":"textarea","id":"quote_6","label":"Card 6 quote"},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":24},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":24},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":2,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Top margin","min":-40,"max":100,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Bottom margin","min":-40,"max":100,"step":2,"unit":"px","default":0},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."},{"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":14}]}
{% endschema %}
