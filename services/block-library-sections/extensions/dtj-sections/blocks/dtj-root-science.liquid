{%- comment -%} GENERATED by tools/build_blocks.py from manifests/root-science.json and src/root-science.liquid. Do not edit this file. {%- endcomment -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ block.settings.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ block.settings.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ block.settings.padding_left | default: 0 }}px; --dtj-pad-right: {{ block.settings.padding_right | default: 0 }}px; --dtj-margin-top: {{ block.settings.margin_top | default: 0 }}px; --dtj-margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px; {% if block.settings.text_color != blank %}--dtj-text-color: {{ block.settings.text_color }};{% endif %} {% if block.settings.background != blank %}--dtj-background: {{ block.settings.background }};{% endif %} --dtj-radius: {{ block.settings.corner_radius | default: 0 }}px; --dtj-text-size: {{ block.settings.text_size | default: 14 }}px;{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign rs_count = 0
  for i in (1..6)
    assign tk = 'text_' | append: i
    assign tv = block.settings[tk] | strip
    if tv != blank
      assign rs_count = rs_count | plus: 1
    endif
  endfor
  assign rs_heading = block.settings.heading | strip
  assign rs_sub = block.settings.subheading | strip
  assign rs_image = block.settings.image
  assign rs_side = 'end'
  if block.settings.image_side == 'start'
    assign rs_side = 'start'
  endif
-%}
{%- if rs_count > 0 or rs_heading != blank or rs_sub != blank -%}
  <div class="dtj-b dtj-rs dtj-rs--img-{{ rs_side }}{% if block.settings.image_shadow %} dtj-rs--shadow{% endif %}" style="{{ dtj_std_style | strip_newlines }} --rs-icon: {{ block.settings.icon_size }}px;{% if block.settings.icon_color != blank %} --rs-accent: {{ block.settings.icon_color }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if rs_heading != blank or rs_sub != blank -%}
      <div class="dtj-rs__intro">
        {%- if rs_heading != blank -%}<h2 class="dtj-rs__head">{{ rs_heading | escape }}</h2>{%- endif -%}
        {%- if rs_sub != blank -%}<p class="dtj-rs__sub">{{ rs_sub | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="dtj-rs__layout">
      {%- if rs_count > 0 -%}
        <div class="dtj-rs__features" role="list">
          {%- for i in (1..6) -%}
            {%- liquid
              assign tk = 'text_' | append: i
              assign ik = 'icon_' | append: i
              assign ck = 'custom_icon_' | append: i
              assign rs_text = block.settings[tk] | strip
              assign rs_icon = block.settings[ik]
              assign rs_custom = block.settings[ck]
            -%}
            {%- if rs_text != blank -%}
              <div class="dtj-rs__feature" role="listitem">
                <span class="dtj-rs__icon" aria-hidden="true">
                  {%- if rs_icon == 'custom' -%}
                    {%- if rs_custom and rs_custom != blank -%}
                      <img class="dtj-rs__icon-img" src="{{ rs_custom | image_url: width: 120 }}" alt="" width="28" height="28" loading="lazy">
                    {%- endif -%}
                  {%- else -%}
                    {%- render 'dtj-feature-icon', name: rs_icon -%}
                  {%- endif -%}
                </span>
                <p class="dtj-rs__text">{{ rs_text | escape }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if rs_image and rs_image != blank -%}
        <figure class="dtj-rs__figure">
          <img class="dtj-rs__img" src="{{ rs_image | image_url: width: 960 }}" alt="{{ block.settings.image_alt | strip | escape }}" width="480" height="480" loading="lazy">
        </figure>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Root Science is empty. Type text into "Feature 1 text" (editor only: shoppers see nothing).</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

