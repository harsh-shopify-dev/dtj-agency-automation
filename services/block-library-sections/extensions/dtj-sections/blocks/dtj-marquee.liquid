{%- capture dtj_std_style -%}--dtj-pad-top: {{ block.settings.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ block.settings.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ block.settings.padding_left | default: 0 }}px; --dtj-pad-right: {{ block.settings.padding_right | default: 0 }}px; --dtj-margin-top: {{ block.settings.margin_top | default: 0 }}px; --dtj-margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px; {% if block.settings.text_color != blank %}--dtj-text-color: {{ block.settings.text_color }};{% endif %} {% if block.settings.background != blank %}--dtj-background: {{ block.settings.background }};{% endif %} --dtj-text-size: {{ block.settings.text_size | default: 14 }}px;{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign mq_count = 0
  for i in (1..10)
    assign tk = 'text_' | append: i
    assign tv = block.settings[tk] | strip
    if tv != blank
      assign mq_count = mq_count | plus: 1
    endif
  endfor
-%}
{%- if mq_count > 0 -%}
  {%- capture mq_items -%}
    {%- for i in (1..10) -%}
      {%- liquid
        assign tk = 'text_' | append: i
        assign ik = 'image_' | append: i
        assign mq_text = block.settings[tk] | strip
        assign mq_image = block.settings[ik]
      -%}
      {%- if mq_text != blank -%}
        <span class="dtj-mq__item">
          {%- if mq_image and mq_image != blank -%}
            <img class="dtj-mq__icon" src="{{ mq_image | image_url: width: 96 }}" alt="" width="18" height="18" loading="lazy">
          {%- elsif block.settings.show_default_icon -%}
            <svg class="dtj-mq__tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.5l3 3 6-6.5"/></svg>
          {%- endif -%}
          <span>{{ mq_text | escape }}</span>
        </span>
        {%- if block.settings.show_dividers -%}<span class="dtj-mq__dot" aria-hidden="true"></span>{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  <div class="dtj-b dtj-mq{% if block.settings.pause_on_hover %} dtj-mq--pause{% endif %}{% if block.settings.uppercase %} dtj-mq--upper{% endif %}" style="{{ dtj_std_style | strip_newlines }} --mq-speed: {{ block.settings.speed }}s; --mq-gap: {{ block.settings.gap }}px; --mq-icon: {{ block.settings.icon_size }}px; --mq-ls: {{ block.settings.letter_spacing | times: 0.01 }}em;{% if block.settings.accent_color != blank %} --mq-accent: {{ block.settings.accent_color }};{% endif %}" {{ block.shopify_attributes }}>
    <div class="dtj-mq__track">
      <div class="dtj-mq__set">{{ mq_items }}</div>
      <div class="dtj-mq__set" aria-hidden="true">{{ mq_items }}</div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Marquee is empty. Type text into "Item 1 text" (editor only: shoppers see nothing).</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

