  "settings": [
    {
      "type": "header",
      "content": "Heading and layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = hidden."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "info": "Empty = hidden."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Empty = same as the text."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "info": "Empty = a softer shade of the text."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 500,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "header",
      "content": "Rating strip"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show the rating strip",
      "default": false,
      "info": "Five stars and the line below. Only tick it if the line states something true."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating line",
      "info": "Your own words and figures. Empty = stars only."
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "info": "Empty = same as the text."
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "Card width",
      "min": 260,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "info": "Empty = transparent."
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border color",
      "info": "Empty = a soft line."
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name color",
      "info": "Empty = same as the text."
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Badge next to the name",
      "info": "For example your own wording for verified buyers. Empty = no badge. Only use it if it is true."
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Badge color",
      "info": "Empty = a softer shade of the text."
    },
    {
      "type": "select",
      "id": "photo_aspect",
      "label": "Photo shape",
      "default": "1/1",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        }
      ]
    },
    {
      "type": "range",
      "id": "photo_radius",
      "label": "Photo corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "tag_bg",
      "label": "Tag background",
      "info": "Empty = a soft tint of the text color."
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag color",
      "info": "Tag text and its round check mark. Empty = same as the text."
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Quote size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "info": "Empty = same as the text."
    },
    {
      "type": "header",
      "content": "Button and trust line"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "info": "Empty = no button."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "cta_full_width",
      "label": "Full width button",
      "default": true
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
