    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small line above the heading. Empty = hidden."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = hidden."
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlighted part of the heading",
      "info": "Type it exactly as it appears in the heading. It is shown on its own line in the highlight color."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "Empty = hidden."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "info": "On phones the cards swipe sideways."
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between cards",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Eyebrow, dose pill and check marks. Empty = same as the text."
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "info": "The highlighted heading line. Empty = accent color."
    },
    {
      "type": "range",
