      "type": "text",
      "id": "rating_label",
      "label": "Rating word",
      "info": "For example the word beside the score. Only type what is true. Empty = hidden."
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating score",
      "info": "Typed by you, never calculated. Empty = hidden."
    },
    {
      "type": "select",
      "id": "rating_stars",
      "label": "Stars beside the rating",
      "default": "0",
