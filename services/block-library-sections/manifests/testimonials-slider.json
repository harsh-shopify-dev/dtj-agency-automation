      "id": "rating_note",
      "label": "Line under the rating",
      "info": "For example how many reviews it is based on. Empty = hidden."
    },
    {
      "type": "select",
      "id": "per_view",
      "label": "Cards in view on desktop",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "per_view_mobile",
      "label": "Cards in view on phones",
      "default": "1.2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "1.2",
          "label": "1 and a peek of the next"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Arrows on desktop",
      "default": true
