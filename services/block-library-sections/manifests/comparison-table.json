      "label": "Other column image"
    },
    {
      "type": "checkbox",
      "id": "highlight_ours",
      "label": "Highlight our column",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_marks",
      "label": "Show a tick / cross beside each row",
      "default": true
    },
