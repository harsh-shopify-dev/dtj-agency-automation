    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = hidden."
    },
    {
      "type": "text",
      "id": "our_label",
      "label": "Our column title"
    },
    {
      "type": "image_picker",
      "id": "our_image",
      "label": "Our column image"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Other column title"
    },
    {
      "type": "image_picker",
