  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = hidden."
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Line under the heading",
      "info": "For example your own review count. Only type what is true. Empty = hidden."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show five stars before that line",
      "default": false,
      "info": "Only tick this if the line states a real rating."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Empty = same as the text."
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Line under the heading: color",
      "info": "Empty = a softer shade of the text."
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Heading position",
      "default": "side",
      "options": [
        {
          "value": "side",
          "label": "Left of the table (wide screens)"
        },
        {
          "value": "top",
          "label": "Above the table"
        }
      ],
      "info": "Use Above the table in a narrow column, such as beside a product."
    },
    {
      "type": "range",
      "id": "header_col_width",
      "label": "Heading column width",
      "min": 220,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Space between heading and table",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Our column"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Our column name",
      "info": "Empty = hidden."
    },
    {
      "type": "image_picker",
      "id": "our_brand_image",
      "label": "Our product image"
    },
    {
      "type": "range",
      "id": "our_image_height",
      "label": "Our image max height",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "checkbox",
      "id": "highlight_our_brand",
      "label": "Highlight our column",
      "default": true
    },
    {
      "type": "color",
      "id": "our_bg_color",
      "label": "Our column background",
      "info": "Empty = a soft tint of the text color."
    },
    {
      "type": "color",
      "id": "our_text_color",
      "label": "Our column text color",
      "info": "Empty = same as the text."
    },
    {
      "type": "header",
      "content": "Other column"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Other column name",
      "info": "Empty = hidden."
    },
    {
      "type": "image_picker",
      "id": "other_brand_image",
      "label": "Other product image"
    },
    {
      "type": "range",
      "id": "other_image_height",
      "label": "Other image max height",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "color",
      "id": "other_bg_color",
      "label": "Other column background",
      "info": "Empty = transparent."
    },
    {
      "type": "color",
      "id": "other_text_color",
      "label": "Other column text color",
      "info": "Empty = same as the text."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 300,
      "max": 1280,
      "step": 20,
      "unit": "px",
      "default": 1080
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider line color",
      "info": "Empty = a soft line."
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Column corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Column side padding",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "row_spacing",
