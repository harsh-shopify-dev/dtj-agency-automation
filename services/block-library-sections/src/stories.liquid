{%- liquid
  assign st_count = 0
  for i in (1..6)
    assign nk = 'name_' | append: i
    assign nv = block.settings[nk] | strip
    if nv != blank
      assign st_count = st_count | plus: 1
    endif
  endfor
  assign st_heading = block.settings.heading | strip
  assign st_sub = block.settings.subheading | strip
  assign st_proof = block.settings.proof_line | strip
  assign st_badge = block.settings.verified_label | strip
  assign st_cta = block.settings.cta_text | strip
  assign st_trust = block.settings.trust_text | strip
  assign st_shape = 'portrait'
  if block.settings.photo_shape == 'square' or block.settings.photo_shape == 'landscape'
    assign st_shape = block.settings.photo_shape
  endif
-%}
{%- if st_count > 0 or st_heading != blank or st_sub != blank or st_proof != blank -%}
  <div class="dtj-b dtj-st dtj-st--{{ st_shape }}" style="{{ dtj_std_style | strip_newlines }} --st-card: {{ block.settings.card_width }}px;{% if block.settings.accent_color != blank %} --st-accent: {{ block.settings.accent_color }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if st_proof != blank or st_heading != blank or st_sub != blank -%}
      <div class="dtj-st__intro">
        {%- if st_proof != blank -%}<p class="dtj-st__proof">{{ st_proof | escape }}</p>{%- endif -%}
        {%- if st_heading != blank -%}<h2 class="dtj-st__head">{{ st_heading | escape }}</h2>{%- endif -%}
        {%- if st_sub != blank -%}<p class="dtj-st__sub">{{ st_sub }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if st_count > 0 -%}
      <div class="dtj-st__track">
        {%- for i in (1..6) -%}
          {%- liquid
            assign nk = 'name_' | append: i
            assign pk = 'photo_' | append: i
            assign qk = 'quote_' | append: i
            assign t1 = 'tag_' | append: i | append: '_1'
            assign t2 = 'tag_' | append: i | append: '_2'
            assign t3 = 'tag_' | append: i | append: '_3'
            assign st_name = block.settings[nk] | strip
            assign st_photo = block.settings[pk]
            assign st_quote = block.settings[qk] | strip
            assign st_t1 = block.settings[t1] | strip
            assign st_t2 = block.settings[t2] | strip
            assign st_t3 = block.settings[t3] | strip
          -%}
          {%- if st_name != blank -%}
            <article class="dtj-st__card">
              <div class="dtj-st__card-head">
                <span class="dtj-st__name">{{ st_name | escape }}</span>
                {%- if st_badge != blank -%}
                  <span class="dtj-st__badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>{{ st_badge | escape }}</span>
                {%- endif -%}
              </div>
              {%- if st_photo and st_photo != blank -%}
                <img class="dtj-st__photo" src="{{ st_photo | image_url: width: 640 }}" alt="" width="300" height="375" loading="lazy">
              {%- endif -%}
              {%- if st_t1 != blank or st_t2 != blank or st_t3 != blank -%}
                <ul class="dtj-st__tags">
                  {%- for t in (1..3) -%}
                    {%- assign tag_key = 'tag_' | append: i | append: '_' | append: t -%}
                    {%- assign tag = block.settings[tag_key] | strip -%}
                    {%- if tag != blank -%}
                      <li class="dtj-st__tag"><span class="dtj-st__dot"><svg viewBox="0 0 24 24" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg></span>{{ tag | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if st_quote != blank -%}<p class="dtj-st__quote">&ldquo;{{ st_quote | escape }}&rdquo;</p>{%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if st_cta != blank -%}
      <div class="dtj-st__cta-wrap">
        <a class="dtj-st__cta" href="{{ block.settings.cta_url | default: '#' }}"><span>{{ st_cta | escape }}</span></a>
        {%- if st_trust != blank -%}<span class="dtj-st__trust">{{ st_trust | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Stories is empty. Type a name into "Card 1 name" (editor only: shoppers see nothing).</p>
{%- endif -%}
