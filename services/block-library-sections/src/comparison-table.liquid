{%- liquid
  assign cm_heading = bs.heading | strip
  assign cm_our = bs.our_label | strip
  assign cm_other = bs.other_label | strip
  assign cm_rows = 0
  for i in (1..8)
    assign ok = 'our_' | append: i
    assign tk = 'other_' | append: i
    assign ov = bs[ok] | strip
    assign tv = bs[tk] | strip
    if ov != blank or tv != blank
      assign cm_rows = cm_rows | plus: 1
    endif
  endfor
  assign cm_head_row = false
  if cm_our != blank or cm_other != blank or bs.our_image != blank or bs.other_image != blank
    assign cm_head_row = true
  endif
-%}
{%- if cm_rows > 0 -%}
  <div class="dtj-b dtj-cmp{% if bs.highlight_ours %} dtj-cmp--hl{% endif %}" style="{{ dtj_std_style | strip_newlines }} --cm-h: {{ bs.heading_size }}px; --cm-img: {{ bs.image_height }}px;{% if bs.accent_color != blank %} --cm-accent: {{ bs.accent_color }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if cm_heading != blank -%}<h2 class="dtj-cmp__head">{{ cm_heading | escape }}</h2>{%- endif -%}
    <table class="dtj-cmp__table">
      {%- if cm_head_row -%}
        <thead>
          <tr>
            <th scope="col" class="dtj-cmp__our">
              {%- if bs.our_image and bs.our_image != blank -%}
                <img class="dtj-cmp__img" src="{{ bs.our_image | image_url: width: 400 }}" alt="" width="96" height="96" loading="lazy">
              {%- endif -%}
              {%- if cm_our != blank -%}<span class="dtj-cmp__label">{{ cm_our | escape }}</span>{%- endif -%}
            </th>
            <th scope="col" class="dtj-cmp__other">
              {%- if bs.other_image and bs.other_image != blank -%}
                <img class="dtj-cmp__img" src="{{ bs.other_image | image_url: width: 400 }}" alt="" width="96" height="96" loading="lazy">
              {%- endif -%}
              {%- if cm_other != blank -%}<span class="dtj-cmp__label">{{ cm_other | escape }}</span>{%- endif -%}
            </th>
          </tr>
        </thead>
      {%- endif -%}
      <tbody>
        {%- for i in (1..8) -%}
          {%- liquid
            assign ok = 'our_' | append: i
            assign tk = 'other_' | append: i
            assign cm_o = bs[ok] | strip
            assign cm_t = bs[tk] | strip
          -%}
          {%- if cm_o != blank or cm_t != blank -%}
            <tr>
              <td class="dtj-cmp__our">
                <span class="dtj-cmp__cell">
                  {%- if bs.show_marks -%}
                    <svg class="dtj-cmp__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle class="dtj-cmp__yes-bg" cx="12" cy="12" r="12"/><path class="dtj-cmp__yes" d="M7 12.5l3.2 3.2L17 8.8"/></svg>
                  {%- endif -%}
                  <span class="dtj-cmp__text">{{ cm_o }}</span>
                </span>
              </td>
              <td class="dtj-cmp__other">
                <span class="dtj-cmp__cell">
                  {%- if bs.show_marks -%}
                    <svg class="dtj-cmp__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle class="dtj-cmp__no-bg" cx="12" cy="12" r="12"/><path class="dtj-cmp__no" d="M8.5 8.5l7 7M15.5 8.5l-7 7"/></svg>
                  {%- endif -%}
                  <span class="dtj-cmp__text">{{ cm_t }}</span>
                </span>
              </td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Comparison Table is empty. Type text into "Row 1: our side" and "Row 1: other side" (editor only: shoppers see nothing).</p>
{%- endif -%}
