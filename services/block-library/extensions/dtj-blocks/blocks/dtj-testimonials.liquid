{%- comment -%} GENERATED by tools/build_blocks.py from manifests/testimonials.json and src/testimonials.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ bs.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ bs.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ bs.padding_left | default: 0 }}px; --dtj-pad-right: {{ bs.padding_right | default: 0 }}px; --dtj-margin-top: {{ bs.margin_top | default: 0 }}px; --dtj-margin-bottom: {{ bs.margin_bottom | default: 0 }}px; {% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %} --dtj-radius: {{ bs.corner_radius | default: 0 }}px;{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign tt_count = 0
  for i in (1..5)
    assign q_key = 'quote_' | append: i
    assign q_val = bs[q_key] | strip
    if q_val != blank
      assign tt_count = tt_count | plus: 1
    endif
  endfor
  assign star_path = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'
-%}
{%- if tt_count > 0 -%}
  <dtj-testimonials class="dtj-b dtj-testimonials" data-interval="{{ bs.interval }}" style="{{ dtj_std_style | strip_newlines }} --tt-pad: {{ bs.card_padding }}px; --tt-border-width: {{ bs.border_width }}px; --tt-quote-size: {{ bs.quote_size }}px; --tt-name-size: {{ bs.name_size }}px; --tt-interval: {{ bs.interval }}s;{% if bs.border_color != blank %} --tt-border-color: {{ bs.border_color }};{% endif %}{% if bs.accent_color != blank %} --tt-accent: {{ bs.accent_color }};{% endif %}{% if bs.star_color != blank %} --tt-star: {{ bs.star_color }};{% endif %}" {{ block.shopify_attributes }}>
    <div class="dtj-testimonials__card" role="region" aria-roledescription="carousel">
      <div class="dtj-testimonials__track" data-track>
        {%- for i in (1..5) -%}
          {%- liquid
            assign q_key = 'quote_' | append: i
            assign n_key = 'name_' | append: i
            assign l_key = 'location_' | append: i
            assign r_key = 'rating_' | append: i
            assign b_key = 'badge_' | append: i
            assign a_key = 'avatar_' | append: i
            assign p_key = 'image_' | append: i
            assign tt_quote = bs[q_key] | strip
            assign tt_name = bs[n_key] | strip
            assign tt_location = bs[l_key] | strip
            assign tt_badge = bs[b_key] | strip
            assign tt_avatar = bs[a_key]
            assign tt_photo = bs[p_key]
            assign tt_stars = bs[r_key] | plus: 0
            assign tt_star_limit = tt_stars | plus: 1
          -%}
          {%- if tt_quote != blank -%}
            <figure class="dtj-testimonials__slide" data-slide>
              <div class="dtj-testimonials__top">
                <div class="dtj-testimonials__avatar">
                  {%- if tt_avatar and tt_avatar != blank -%}
                    <img src="{{ tt_avatar | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
                  {%- else -%}
                    <span>{{- tt_name | slice: 0 | escape -}}</span>
                  {%- endif -%}
                </div>
                <div class="dtj-testimonials__header">
                  {%- if tt_name != blank -%}<span class="dtj-testimonials__name">{{ tt_name | escape }}</span>{%- endif -%}
                  {%- if tt_location != blank -%}<span class="dtj-testimonials__location">{{ tt_location | escape }}</span>{%- endif -%}
                  {%- if tt_stars > 0 -%}
                    <span class="dtj-testimonials__stars" role="img" aria-label="{{ tt_stars }} / 5">
                      {%- for s in (1..5) -%}
                        {%- if s < tt_star_limit -%}
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{ star_path }}"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="{{ star_path }}"/></svg>
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                  {%- if tt_badge != blank -%}<span class="dtj-testimonials__badge">{{ tt_badge | escape }}</span>{%- endif -%}
                </div>
              </div>
              <div class="dtj-testimonials__body">
                <blockquote class="dtj-testimonials__quote">{{ tt_quote | escape }}</blockquote>
                {%- if tt_photo and tt_photo != blank -%}
                  <img class="dtj-testimonials__photo" src="{{ tt_photo | image_url: width: 150 }}" alt="" width="64" height="64" loading="lazy">
                {%- endif -%}
              </div>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if tt_count > 1 -%}
        <button type="button" class="dtj-testimonials__next" data-next aria-label="{{ bs.next_label | default: 'Next' | escape }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
        {%- if bs.show_progress -%}<div class="dtj-testimonials__progress" data-progress aria-hidden="true"></div>{%- endif -%}
      {%- endif -%}
    </div>
  </dtj-testimonials>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Testimonials is empty. Type text into "Review 1 text" (editor only: shoppers see nothing).</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

