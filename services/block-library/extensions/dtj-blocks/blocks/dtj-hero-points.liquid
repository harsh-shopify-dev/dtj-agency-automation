{%- comment -%} GENERATED by tools/build_blocks.py from manifests/hero-points.json and src/hero-points.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ bs.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ bs.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ bs.padding_left | default: 0 }}px; --dtj-pad-right: {{ bs.padding_right | default: 0 }}px; --dtj-margin-top: {{ bs.margin_top | default: 0 }}px; --dtj-margin-bottom: {{ bs.margin_bottom | default: 0 }}px; {% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %}{%- endcapture -%}
{%- capture dtj_content -%}
{%- assign hp_eyebrow = bs.eyebrow | strip -%}
{%- assign hp_sub = bs.subheading | strip -%}
{%- assign hp_lines = bs.benefits | newline_to_br | split: '<br />' -%}
{%- assign hp_count = 0 -%}
{%- assign hp_cols = 1 -%}
{%- if bs.columns == '2' -%}{%- assign hp_cols = 2 -%}{%- endif -%}
{%- capture hp_items -%}
  {%- for line in hp_lines limit: 40 -%}
    {%- assign hp_line = line | strip -%}
    {%- if hp_line != blank and hp_count < 8 -%}
      {%- assign hp_count = hp_count | plus: 1 -%}
      {%- comment -%} "icon | text" picks a line's icon (protein, peanut, no-sugar, chilli, flame, fibre, leaf, no-colour, no-preservative, jar...): Harsh, 25 Oct 2026 {%- endcomment -%}
      {%- assign hp_icon = 'check' -%}
      {%- assign hp_text = hp_line -%}
      {%- if hp_line contains '|' -%}
        {%- assign hp_parts = hp_line | split: '|' -%}
        {%- assign hp_icon = hp_parts.first | strip | downcase -%}
        {%- assign hp_text = hp_parts.last | strip -%}
      {%- endif -%}
      <li class="dtj-ci{% if bs.icon_style == 'ring' %} dtj-ci--ring{% endif %}">
        <span class="dtj-ci__icon" aria-hidden="true">{% render 'dtj-check-icon', name: hp_icon, size: bs.check_size, style: bs.icon_style %}</span>
        <span class="dtj-ci__text">{{ hp_text | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if hp_eyebrow != blank or hp_sub != blank or hp_items contains '<li' -%}
  <div class="dtj-b dtj-hero-points{% if hp_cols == 2 and bs.stack_mobile %} dtj-hero-points--stack{% endif %}" data-columns="{{ hp_cols }}" style="{{ dtj_std_style | strip_newlines }} --hp-cols: {{ hp_cols }}; --hp-gap: {{ bs.gap }}px; --hp-tick-gap: {{ bs.tick_gap }}px; --hp-col-gap: {{ bs.column_gap }}px; --hp-eyebrow-size: {{ bs.eyebrow_size }}px; --hp-sub-size: {{ bs.subheading_size }}px; --hp-tick-size: {{ bs.tick_size }}px; --dtj-ci-size: {{ bs.check_size }}px; --dtj-ci-gap: 10px;{% if bs.accent_color != blank %} --hp-accent: {{ bs.accent_color }};{% endif %}{% if bs.eyebrow_color != blank %} --hp-eyebrow-color: {{ bs.eyebrow_color }};{% endif %}{% if bs.ring_color != blank %} --dtj-ring-color: {{ bs.ring_color }};{% endif %}{% if bs.ring_glyph_color != blank %} --dtj-ring-glyph: {{ bs.ring_glyph_color }};{% endif %}{% if bs.ring_fill != blank %} --dtj-ring-fill: {{ bs.ring_fill }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if hp_eyebrow != blank -%}
      <span class="dtj-hero-points__eyebrow">
        {%- if bs.show_star -%}
          <svg class="dtj-hero-points__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 7.1-1.01L12 2z"/></svg>
        {%- endif -%}
        {{ hp_eyebrow | escape }}
      </span>
    {%- endif -%}
    {%- if hp_sub != blank -%}
      <div class="dtj-hero-points__sub">{{ hp_sub }}</div>
    {%- endif -%}
    {%- if hp_items contains '<li' -%}
      <ul class="dtj-hero-points__list">{{ hp_items }}</ul>
    {%- endif -%}
  </div>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

{% schema %}
{"name":"DTJ Hero Points","target":"section","stylesheet":"dtj-hero-points.css","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow label","info":"Small uppercase pill. Empty = hidden."},{"type":"checkbox","id":"show_star","label":"Star inside the eyebrow","default":true},{"type":"inline_richtext","id":"subheading","label":"Subheading","info":"Bold is allowed. Empty = hidden."},{"type":"textarea","id":"benefits","label":"Benefits","info":"One benefit per line, up to 8. Empty = hidden. \"protein | 26 g protein per 100 g\" picks a line's icon: protein, peanut, no-sugar, chilli, flame, fibre, leaf, no-colour, no-preservative, jar, shield, heart, star, truck, return, lock."},{"type":"select","id":"columns","label":"Columns","default":"1","options":[{"value":"1","label":"1 column"},{"value":"2","label":"2 columns"}],"info":"2 columns reads left to right, then down: 1 2 / 3 4."},{"type":"checkbox","id":"stack_mobile","label":"Use 1 column on phones","default":false,"info":"Only matters with 2 columns. Off = keep 2 columns on phones too."},{"type":"color","id":"accent_color","label":"Accent color","info":"Eyebrow pill, star and tick circles. Empty = same as the text."},{"type":"select","id":"icon_style","label":"Icon style","default":"tick","options":[{"value":"tick","label":"Tick on a filled circle"},{"value":"ring","label":"Line icon in a ring"}],"info":"Ring = a line icon per benefit inside a thin coloured ring (pick icons with \"icon | text\")."},{"type":"color","id":"ring_color","label":"Ring color","info":"Ring style only. Empty = the accent color."},{"type":"color","id":"ring_glyph_color","label":"Ring icon color","info":"Ring style only. Empty = same as the text."},{"type":"color","id":"ring_fill","label":"Ring fill","info":"Ring style only. Empty = transparent."},{"type":"color","id":"eyebrow_color","label":"Eyebrow text color","info":"Empty = same as the text."},{"type":"header","content":"Sizes and gaps"},{"type":"range","id":"eyebrow_size","label":"Eyebrow text size","min":9,"max":16,"step":1,"unit":"px","default":11},{"type":"range","id":"subheading_size","label":"Subheading size","min":12,"max":28,"step":1,"unit":"px","default":16},{"type":"range","id":"tick_size","label":"Benefit text size","min":12,"max":24,"step":1,"unit":"px","default":14},{"type":"range","id":"check_size","label":"Tick circle size","min":14,"max":36,"step":2,"unit":"px","default":20},{"type":"range","id":"gap","label":"Space between the parts","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"range","id":"tick_gap","label":"Space between benefits","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"range","id":"column_gap","label":"Space between columns","min":8,"max":48,"step":2,"unit":"px","default":20},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":4},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":4},{"type":"range","id":"padding_left","label":"Left padding","min":0,"max":100,"step":2,"unit":"px","default":0},{"type":"range","id":"padding_right","label":"Right padding","min":0,"max":100,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Top margin","min":-40,"max":100,"step":2,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Bottom margin","min":-40,"max":100,"step":2,"unit":"px","default":0},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}]}
{% endschema %}
