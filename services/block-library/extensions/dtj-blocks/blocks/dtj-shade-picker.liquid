ch","label":"Option 5 swatch image","info":"Empty = the product's own image."},{"type":"text","id":"s6_label","label":"Option 6 name","info":"Empty = the product title."},{"type":"text","id":"s6_subtitle","label":"Option 6 subtitle","info":"Optional short line."},{"type":"image_picker","id":"s6_swatch","label":"Option 6 swatch image","info":"Empty = the product's own image."},{"type":"text","id":"s7_label","label":"Option 7 name","info":"Empty = the product title."},{"type":"text","id":"s7_subtitle","label":"Option 7 subtitle","info":"Optional short line."},{"type":"image_picker","id":"s7_swatch","label":"Option 7 swatch image","info":"Empty = the product's own image."},{"type":"text","id":"s8_label","label":"Option 8 name","info":"Empty = the product title."},{"type":"text","id":"s8_subtitle","label":"Option 8 subtitle","info":"Optional short line."},{"type":"image_picker","id":"s8_swatch","label":"Option 8 swatch image","info":"Empty = the product's own image."},{"type":"header","content":"Style"},{"type":"select","id":"style","label":"Display style","default":"swatch","info":"Swatch = round product photo. Pill = text button.","options":[{"value":"swatch","label":"Swatch (round photo)"},{"value":"pill","label":"Pill (text button)"}]},{"type":"range","id":"swatch_size","label":"Swatch size","min":24,"max":56,"step":2,"unit":"px","default":32},{"type":"checkbox","id":"show_caption","label":"Show the name beside the swatch","default":true},{"type":"range","id":"caption_size","label":"Name size","min":11,"max":16,"step":1,"unit":"px","default":13},{"type":"range","id":"subtitle_size","label":"Subtitle size","min":9,"max":13,"step":1,"unit":"px","default":11},{"type":"range","id":"pill_radius","label":"Pill corner radius","min":4,"max":24,"step":1,"unit":"px","default":6},{"type":"range","id":"gap","label":"Gap between options","min":4,"max":20,"step":1,"unit":"px","default":12},{"type":"color","id":"accent_color","label":"Selected option color","info":"Empty = same as