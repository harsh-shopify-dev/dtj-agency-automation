{%- comment -%} GENERATED by tools/build_blocks.py from manifests/addons.json and src/addons.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ bs.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ bs.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ bs.padding_left | default: 0 }}px; --dtj-pad-right: {{ bs.padding_right | default: 0 }}px; --dtj-margin-top: {{ bs.margin_top | default: 0 }}px; --dtj-margin-bottom: {{ bs.margin_bottom | default: 0 }}px; {% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %} --dtj-radius: {{ bs.corner_radius | default: 0 }}px; --dtj-text-size: {{ bs.text_size | default: 14 }}px;{%- endcapture -%}
{%- capture dtj_content -%}
{%- comment -%} A product_list is read by looping over it in order (Shopify docs), never by position like ao_list[0]. {%- endcomment -%}
{%- liquid
  assign ao_list = bs.products
  assign ao_has = false
  assign ao_seen = 0
  for first_p in ao_list limit: 4
    assign ao_seen = ao_seen | plus: 1
    if first_p and first_p != blank
      assign ao_has = true
    endif
  endfor
  assign ao_main_variant = product.selected_or_first_available_variant
  assign ao_prices = ''
  for v in product.variants limit: 100
    assign ao_prices = ao_prices | append: v.id | append: ':' | append: v.price | append: ','
  endfor
  assign ao_heading = bs.heading | strip
  assign ao_sub = bs.subheading | strip
-%}
{%- if ao_has -%}
  <dtj-addons class="dtj-b dtj-addons" data-after-add="{{ bs.after_add }}" data-money-format="{{ shop.money_format | escape }}" data-main-variant="{{ ao_main_variant.id }}" data-main-prices="{{ ao_prices }}" data-select-label="{{ bs.select_label | escape }}" data-selected-label="{{ bs.selected_label | escape }}" style="{{ dtj_std_style | strip_newlines }} --ao-heading: {{ bs.heading_size }}px; --ao-headline: {{ bs.headline_size }}px; --ao-price: {{ bs.price_size }}px;{% if bs.accent_color != blank %} --ao-accent: {{ bs.accent_color }};{% endif %}{% if bs.border_color != blank %} --ao-border: {{ bs.border_color }};{% endif %}{% if bs.card_bg != blank %} --ao-card-bg: {{ bs.card_bg }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if ao_heading != blank or bs.show_total -%}
      <div class="dtj-addons__head">
        {%- if ao_heading != blank -%}<h3 class="dtj-addons__title">{{ ao_heading | escape }}</h3>{%- endif -%}
        {%- if bs.show_total -%}
          <div class="dtj-addons__total" data-total aria-live="polite">
            <span data-total-value></span>
            {%- if bs.total_label != blank -%}<small>{{ bs.total_label | escape }}</small>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if ao_sub != blank -%}<p class="dtj-addons__sub">{{ ao_sub | escape }}</p>{%- endif -%}
    <div class="dtj-addons__list">
      {%- for p_main in ao_list limit: 4 -%}
        {%- liquid
          assign i = forloop.index
          assign ak = 's' | append: i | append: '_alt'
          assign hk = 's' | append: i | append: '_headline'
          assign sk = 's' | append: i | append: '_subline'
          assign bk = 's' | append: i | append: '_badge'
          assign ck = 's' | append: i | append: '_show_compare'
          assign alt_pos = bs[ak] | plus: 0
          assign p_alt = nil
          if alt_pos > 0 and alt_pos != i
            for q in ao_list limit: 8
              if forloop.index == alt_pos
                assign p_alt = q
                break
              endif
            endfor
          endif
        -%}
        {%- if p_main and p_main != blank -%}
          {%- liquid
            assign v_main = p_main.selected_or_first_available_variant
            assign has_alt = false
            if p_alt and p_alt != blank
              assign has_alt = true
              assign v_alt = p_alt.selected_or_first_available_variant
            endif
            assign ao_name = bs[hk] | strip | default: p_main.title
            assign ao_line = bs[sk] | strip
            assign ao_badge = bs[bk] | strip
            assign compare_main = v_main.price
            if v_main.compare_at_price and v_main.compare_at_price > v_main.price
              assign compare_main = v_main.compare_at_price
            endif
            assign compare_alt = 0
            if has_alt
              assign compare_alt = v_alt.price
              if v_alt.compare_at_price and v_alt.compare_at_price > v_alt.price
                assign compare_alt = v_alt.compare_at_price
              endif
            endif
            assign ao_sold_out = true
            if v_main.available
              assign ao_sold_out = false
            endif
            assign slot_text = i | append: ''
            assign ao_recommended = false
            if bs.recommended_slot == slot_text
              assign ao_recommended = true
            endif
            assign ao_thumb = v_main.featured_media
            if ao_thumb == blank
              assign ao_thumb = p_main.featured_media
            endif
          -%}
          <div class="dtj-addons__card" data-card data-selected="false" data-sold-out="{{ ao_sold_out }}" data-recommended="{{ ao_recommended }}" data-rec-label="{{ bs.recommended_label | escape }}" data-variant-main="{{ v_main.id }}"{% if has_alt %} data-variant-alt="{{ v_alt.id }}"{% endif %} data-price-main="{{ v_main.price }}"{% if has_alt %} data-price-alt="{{ v_alt.price }}"{% endif %} data-compare-main="{{ compare_main }}"{% if has_alt %} data-compare-alt="{{ compare_alt }}"{% endif %} data-show-compare="{{ bs[ck] }}" data-active-variant="main" role="button" tabindex="0" aria-pressed="false" aria-label="{{ ao_name | escape }}">
            <div class="dtj-addons__thumb" data-thumb>
              {%- if ao_thumb and ao_thumb != blank -%}
                <img src="{{ ao_thumb | image_url: width: 200 }}" alt="" width="64" height="64" loading="lazy">
              {%- endif -%}
            </div>
            <div class="dtj-addons__body">
              <p class="dtj-addons__headline" data-headline>{{ ao_name | escape }}</p>
              {%- if ao_line != blank -%}<p class="dtj-addons__subline">{{ ao_line | escape }}</p>{%- endif -%}
              <div class="dtj-addons__meta">
                <span class="dtj-addons__price" data-price>{{ v_main.price | money }}</span>
                {%- if bs[ck] -%}
                  <span class="dtj-addons__compare" data-compare{% unless compare_main > v_main.price %} hidden{% endunless %}>{{ compare_main | money }}</span>
                {%- endif -%}
                {%- if ao_badge != blank -%}<span class="dtj-addons__badge">{{ ao_badge | escape }}</span>{%- endif -%}
              </div>
            </div>
            {%- if has_alt -%}
              <div class="dtj-addons__swap" role="group">
                <button type="button" data-swap="main" aria-pressed="true" data-variant="{{ v_main.id }}" data-title="{{ ao_name | escape }}" data-image="{% if ao_thumb and ao_thumb != blank %}{{ ao_thumb | image_url: width: 200 }}{% endif %}"><span>{{ ao_name | escape }}</span></button>
                <button type="button" data-swap="alt" aria-pressed="false" data-variant="{{ v_alt.id }}" data-title="{{ p_alt.title | escape }}" data-image="{% if p_alt.featured_media %}{{ p_alt.featured_media | image_url: width: 200 }}{% endif %}"><span>{{ p_alt.title | escape }}</span></button>
              </div>
            {%- endif -%}
            <span class="dtj-addons__cta" aria-hidden="true">
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6 5 9 10 3" pathLength="1"/></svg>
              <span data-cta-label>{% if ao_sold_out %}{{ bs.sold_out_label | escape }}{% else %}{{ bs.select_label | escape }}{% endif %}</span>
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </dtj-addons>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Add-ons is empty. Choose at least one product under "Add-on products" (editor only: shoppers see nothing). Products received: {{ ao_seen }}. Raw list size: {{ bs.products.size | default: 'none' }}; list: {{ bs.products | json | truncate: 150 | escape }}; settings: {{ bs | json | truncate: 260 | escape }}</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

