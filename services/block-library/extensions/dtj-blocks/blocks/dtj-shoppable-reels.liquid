{%- comment -%} GENERATED by tools/build_blocks.py from manifests/shoppable-reels.json and src/shoppable-reels.liquid. Do not edit this file. {%- endcomment -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ block.settings.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ block.settings.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ block.settings.padding_left | default: 0 }}px; --dtj-pad-right: {{ block.settings.padding_right | default: 0 }}px; --dtj-margin-top: {{ block.settings.margin_top | default: 0 }}px; --dtj-margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px; {% if block.settings.text_color != blank %}--dtj-text-color: {{ block.settings.text_color }};{% endif %} {% if block.settings.background != blank %}--dtj-background: {{ block.settings.background }};{% endif %} --dtj-radius: {{ block.settings.corner_radius | default: 0 }}px; --dtj-text-size: {{ block.settings.text_size | default: 14 }}px;{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign sr_count = 0
  for i in (1..6)
    assign v_key = 'video_' | append: i
    assign i_key = 'image_' | append: i
    assign m_key = 'media_type_' | append: i
    assign sr_video = block.settings[v_key]
    assign sr_image = block.settings[i_key]
    if block.settings[m_key] == 'video' and sr_video and sr_video != blank
      assign sr_count = sr_count | plus: 1
    elsif sr_image and sr_image != blank
      assign sr_count = sr_count | plus: 1
    endif
  endfor
  assign sr_heading = block.settings.heading | strip
-%}
{%- if sr_count > 0 -%}
  <div class="dtj-b dtj-reels" style="{{ dtj_std_style | strip_newlines }} --sr-card: {{ block.settings.card_width }}px; --sr-card-m: {{ block.settings.card_width_mobile }}px; --sr-gap: {{ block.settings.card_gap }}px;{% if block.settings.price_color != blank %} --sr-price: {{ block.settings.price_color }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if sr_heading != blank -%}
      <h3 class="dtj-reels__heading">{{ sr_heading | escape }}</h3>
    {%- endif -%}
    <dtj-reels class="dtj-reels__track" data-play-label="{{ block.settings.play_label | default: 'Play video' | escape }}" data-pause-label="{{ block.settings.pause_label | default: 'Pause video' | escape }}" data-sound-on-label="{{ block.settings.sound_on_label | default: 'Turn sound on' | escape }}" data-sound-off-label="{{ block.settings.sound_off_label | default: 'Turn sound off' | escape }}">
      {%- for i in (1..6) -%}
        {%- liquid
          assign v_key = 'video_' | append: i
          assign i_key = 'image_' | append: i
          assign p_idx = i | minus: 1
          assign m_key = 'media_type_' | append: i
          assign sr_video = block.settings[v_key]
          assign sr_image = block.settings[i_key]
          assign sr_product = block.settings.products[p_idx]
          assign sr_show_video = false
          if block.settings[m_key] == 'video' and sr_video and sr_video != blank
            assign sr_show_video = true
          endif
          assign sr_show_image = false
          if sr_show_video == false and sr_image and sr_image != blank
            assign sr_show_image = true
          endif
        -%}
        {%- if sr_show_video or sr_show_image -%}
          <div class="dtj-reels__slide">
            <div class="dtj-reels__media">
              {%- if sr_show_video -%}
                {%- assign sr_video_id = 'dtj-reel-' | append: block.id | append: '-' | append: i -%}
                {{ sr_video | video_tag: id: sr_video_id, autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', class: 'dtj-reels__video' }}
                <button type="button" class="dtj-reels__toggle" data-toggle data-target="{{ sr_video_id }}" aria-label="{{ block.settings.play_label | default: 'Play video' | escape }}">
                  <svg class="dtj-reels__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="dtj-reels__icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
                </button>
                <button type="button" class="dtj-reels__sound" data-sound data-target="{{ sr_video_id }}" aria-pressed="false" aria-label="{{ block.settings.sound_on_label | default: 'Turn sound on' | escape }}">
                  <svg class="dtj-reels__icon-sound-off" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9z"/><path d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <svg class="dtj-reels__icon-sound-on" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9z"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
              {%- else -%}
                <img class="dtj-reels__image" src="{{ sr_image | image_url: width: 480 }}" alt="{{ sr_image.alt | default: sr_product.title | escape }}" width="{{ sr_image.width }}" height="{{ sr_image.height }}" loading="lazy">
              {%- endif -%}
              {%- if sr_product and sr_product != blank -%}
                <div class="dtj-reels__product">
                  <a href="{{ sr_product.url }}" class="dtj-reels__link">
                    <span class="dtj-reels__title">{{ sr_product.title | escape }}</span>
                    <span class="dtj-reels__price">{{ sr_product.price | money }}</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dtj-reels>
  </div>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

