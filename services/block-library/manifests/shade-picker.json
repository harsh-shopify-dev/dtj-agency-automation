  "data_needs": [
    "a product for each option (the options are separate products, not variants)"
  ],
  "reference_image": null,
  "test": {
    "sample": {
      "label_text": "Label sample",
      "products": [
        {
          "id": 1,
          "handle": "h1",
          "title": "Product A",
          "url": "/products/h1",
          "featured_media": "media-1",
