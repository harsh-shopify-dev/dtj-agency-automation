    {
      "type": "product_list",
      "id": "products",
      "label": "Option products",
      "limit": 8,
      "info": "Pick the products in the order they should show (up to 8). Option 1 is the first, and the name, subtitle and swatch below follow the same order."
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label above the options",
      "info": "For example the name of the option family. Empty = no label."
    },
    {
      "type": "checkbox",
      "id": "show_selected",
      "label": "Show the current or hovered name beside the label",
