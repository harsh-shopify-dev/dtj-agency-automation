{
  "id": "addons",
  "title": "DTJ Add-ons",
  "block_file": "extensions/dtj-blocks/blocks/dtj-addons.liquid",
  "placements": [
    "product"
  ],
  "licence": true,
  "min_filled_slots": 1,
  "script": true,
  "slots": [
    {
      "id": "products",
      "type": "product_list",
      "required": true
    },
    {
      "id": "heading",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "subheading",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "s1_headline",
      "type": "text",
      "required": false,
      "max_length": 50
    },
    {
      "id": "s1_subline",
      "type": "text",
      "required": false,
      "max_length": 100
    },
    {
      "id": "s1_badge",
      "type": "text",
      "required": false,
      "max_length": 24
    },
    {
      "id": "s2_headline",
      "type": "text",
      "required": false,
      "max_length": 50
    },
    {
      "id": "s2_subline",
      "type": "text",
      "required": false,
      "max_length": 100
    },
    {
      "id": "s2_badge",
      "type": "text",
      "required": false,
      "max_length": 24
    },
    {
      "id": "s3_headline",
      "type": "text",
      "required": false,
      "max_length": 50
    },
    {
      "id": "s3_subline",
      "type": "text",
      "required": false,
      "max_length": 100
    },
    {
      "id": "s3_badge",
      "type": "text",
      "required": false,
      "max_length": 24
    },
    {
      "id": "s4_headline",
      "type": "text",
      "required": false,
      "max_length": 50
    },
    {
      "id": "s4_subline",
      "type": "text",
      "required": false,
      "max_length": 100
    },
    {
      "id": "s4_badge",
      "type": "text",
      "required": false,
      "max_length": 24
    }
  ],
  "standard_controls": [
    "spacing",
    "colors",
    "shape",
    "text_size"
  ],
  "standard_defaults": {
    "corner_radius": 8,
    "text_size": 14,
    "padding_top": 6,
    "padding_bottom": 6
  },
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Add-on products",
      "limit": 8,
      "info": "Pick the products in order. The first four become the add-on cards. Products 5 to 8 can only be used as alternatives. Each must be published to the Online Store."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Empty = hidden."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional short line under the heading."
    },
    {
      "type": "checkbox",
      "id": "show_total",
      "label": "Show a live total (product + ticked add-ons)",
      "default": true
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Label under the total",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "select_label",
      "label": "Button text when not selected",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "selected_label",
      "label": "Button text when selected",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Button text when sold out",
      "info": "Optional."
    },
    {
      "type": "select",
      "id": "recommended_slot",
      "label": "Highlight one add-on as recommended",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "Add-on 1"
        },
        {
          "value": "2",
          "label": "Add-on 2"
        },
        {
          "value": "3",
          "label": "Add-on 3"
        },
        {
          "value": "4",
          "label": "Add-on 4"
        }
      ]
    },
    {
      "type": "text",
      "id": "recommended_label",
      "label": "Recommended tag text",
      "info": "Shown on the highlighted add-on. Empty = no tag."
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "default": "cart",
      "info": "Cart page always works. Opening the cart drawer is a best guess that depends on the theme.",
      "options": [
        {
          "value": "cart",
          "label": "Go to the cart page"
        },
        {
          "value": "drawer",
          "label": "Open the cart drawer (best effort)"
        },
        {
          "value": "checkout",
          "label": "Go to checkout"
        }
      ]
    },
    {
      "type": "select",
      "id": "s1_alt",
      "label": "Add-on 1 alternative",
      "default": "0",
      "info": "Optional: offer another product from the list as a switch. Use a position that is not already one of the four cards (5 to 8).",
      "options": [
        {
          "value": "0",
          "label": "None"
        },
        {
          "value": "1",
          "label": "Product 1 in the list"
        },
        {
          "value": "2",
          "label": "Product 2 in the list"
        },
        {
          "value": "3",
          "label": "Product 3 in the list"
        },
        {
          "value": "4",
          "label": "Product 4 in the list"
        },
        {
          "value": "5",
          "label": "Product 5 in the list"
        },
        {
          "value": "6",
          "label": "Product 6 in the list"
        },
        {
          "value": "7",
          "label": "Product 7 in the list"
        },
        {
          "value": "8",
          "label": "Product 8 in the list"
        }
      ]
    },
    {
      "type": "text",
      "id": "s1_headline",
      "label": "Add-on 1 name",
      "info": "Empty = the product title."
    },
    {
      "type": "text",
      "id": "s1_subline",
      "label": "Add-on 1 description"
    },
    {
      "type": "text",
      "id": "s1_badge",
      "label": "Add-on 1 badge",
      "info": "Optional short tag. Only a claim you can stand behind."
    },
    {
      "type": "checkbox",
      "id": "s1_show_compare",
      "label": "Add-on 1: show the crossed-out compare-at price",
      "info": "Only the real compare-at price of the product, never a made-up one.",
      "default": true
