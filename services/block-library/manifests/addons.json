  "data_needs": [
    "products used as add-ons must be published to the Online Store",
    "the theme's product form (form action /cart/add)"
  ],
  "reference_image": null,
  "test": {
    "sample": {
      "heading": "Heading sample",
      "products": [
        {
          "id": 1,
          "handle": "h1",
          "title": "Product One",
          "url": "/products/h1",
          "featured_media": "media-1",
          "variants": [
            {
              "id": 10,
              "price": 50000
            }
          ],
          "selected_or_first_available_variant": {
            "id": 10,
            "price": 50000,
            "compare_at_price": 70000,
            "available": true,
            "featured_media": null
          }
        },
        {
          "id": 2,
          "handle": "h2",
          "title": "Product Two",
          "url": "/products/h2",
          "featured_media": "media-2",
          "variants": [
            {
              "id": 20,
              "price": 30000
            }
          ],
          "selected_or_first_available_variant": {
            "id": 20,
            "price": 30000,
            "compare_at_price": null,
            "available": true,
            "featured_media": null
          }
        }
      ]
    },
    "expect": [
      "Heading sample",
      "Product One",
      "Product Two",
      "dtj-addons",
      "data-variant-main=\"10\"",
      "data-price-main=\"50000\""
    ]
  }
