{%- liquid
  assign sp_list = block.settings.products
  assign sp_current = product.handle | default: ''
  assign sp_has = false
  assign sp_selected = ''
  for i in (1..8)
    assign idx = i | minus: 1
    assign lk = 's' | append: i | append: '_label'
    assign p = sp_list[idx]
    if p and p != blank
      assign sp_has = true
      if p.handle == sp_current
        assign sp_selected = block.settings[lk] | strip | default: p.title
      endif
    endif
  endfor
  assign sp_label = block.settings.label_text | strip
-%}
{%- if sp_has -%}
  <dtj-shade-picker class="dtj-b dtj-shade-picker dtj-shade-picker--{{ block.settings.style }}" style="{{ dtj_std_style | strip_newlines }} --sp-swatch: {{ block.settings.swatch_size }}px; --sp-caption: {{ block.settings.caption_size }}px; --sp-subtitle: {{ block.settings.subtitle_size }}px; --sp-radius: {{ block.settings.pill_radius }}px; --sp-gap: {{ block.settings.gap }}px;{% if block.settings.accent_color != blank %} --sp-accent: {{ block.settings.accent_color }};{% endif %}{% if block.settings.border_color != blank %} --sp-border: {{ block.settings.border_color }};{% endif %}" {{ block.shopify_attributes }}>
    {%- if sp_label != blank or block.settings.show_selected and sp_selected != blank -%}
      <p class="dtj-shade-picker__label">
        {{- sp_label | escape -}}
        {%- if block.settings.show_selected and sp_selected != blank %} <strong data-selected>{{ sp_selected | escape }}</strong>{% endif -%}
      </p>
    {%- endif -%}
    <div class="dtj-shade-picker__row">
      {%- for i in (1..8) -%}
        {%- liquid
          assign idx = i | minus: 1
          assign lk = 's' | append: i | append: '_label'
          assign tk = 's' | append: i | append: '_subtitle'
          assign wk = 's' | append: i | append: '_swatch'
          assign p = sp_list[idx]
          assign sp_text = block.settings[lk] | strip | default: p.title
          assign sp_sub = block.settings[tk] | strip
          assign sp_img = block.settings[wk]
          assign sp_is_current = false
          if p.handle == sp_current
            assign sp_is_current = true
          endif
          assign sp_sold_out = true
          if p.selected_or_first_available_variant.available
            assign sp_sold_out = false
          endif
        -%}
        {%- if p and p != blank -%}
          {%- if block.settings.style == 'pill' -%}
            <a class="dtj-shade-picker__pill" href="{{ p.url }}" data-item data-label="{{ sp_text | escape }}" data-current="{{ sp_is_current }}" data-unavailable="{{ sp_sold_out }}"{% if sp_is_current %} aria-current="page"{% endif %}{% if sp_sold_out %} aria-disabled="true"{% endif %}>{{ sp_text | escape }}</a>
          {%- else -%}
            <a class="dtj-shade-picker__item" href="{{ p.url }}" data-item data-label="{{ sp_text | escape }}" data-current="{{ sp_is_current }}" data-unavailable="{{ sp_sold_out }}" title="{{ sp_text | escape }}"{% if sp_is_current %} aria-current="page"{% endif %}{% if sp_sold_out %} aria-disabled="true"{% endif %}>
              <span class="dtj-shade-picker__swatch">
                {%- if sp_img and sp_img != blank -%}
                  <img class="dtj-shade-picker__img" src="{{ sp_img | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
                {%- elsif p.featured_media -%}
                  <img class="dtj-shade-picker__img" src="{{ p.featured_media | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy">
                {%- endif -%}
              </span>
              {%- if block.settings.show_caption -%}
                <span class="dtj-shade-picker__text">
                  <span class="dtj-shade-picker__caption">{{ sp_text | escape }}</span>
                  {%- if sp_sub != blank -%}<span class="dtj-shade-picker__subtitle">{{ sp_sub | escape }}</span>{%- endif -%}
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </dtj-shade-picker>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Option Picker is empty. Choose at least one product under "Option products" (editor only: shoppers see nothing).</p>
{%- endif -%}
