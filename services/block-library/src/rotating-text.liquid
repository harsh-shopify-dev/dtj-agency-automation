{%- assign rt_first = '' -%}
{%- capture rt_json -%}[
  {%- assign rt_comma = false -%}
  {%- for i in (1..6) -%}
    {%- assign rt_key = 'phrase_' | append: i -%}
    {%- assign rt_phrase = block.settings[rt_key] | strip -%}
    {%- if rt_phrase != blank -%}
      {%- if rt_comma %},{% endif -%}
      {{- rt_phrase | json -}}
      {%- assign rt_comma = true -%}
    {%- endif -%}
  {%- endfor -%}
]{%- endcapture -%}
{%- for i in (1..6) -%}
  {%- assign rt_key = 'phrase_' | append: i -%}
  {%- assign rt_candidate = block.settings[rt_key] | strip -%}
  {%- if rt_first == blank and rt_candidate != blank -%}
    {%- assign rt_first = rt_candidate -%}
  {%- endif -%}
{%- endfor -%}
{%- if rt_first != blank -%}
  <dtj-rotating-text class="dtj-b dtj-rotating-text" data-phrases="{{ rt_json | escape }}" data-type-speed="{{ block.settings.type_speed }}" data-delete-speed="{{ block.settings.delete_speed }}" data-pause="{{ block.settings.pause_time }}" style="{{ dtj_std_style | strip_newlines }} --dtj-rt-weight: {{ block.settings.text_weight }};{% if block.settings.prefix_color != blank %} --dtj-rt-prefix: {{ block.settings.prefix_color }};{% endif %}" {{ block.shopify_attributes }}>
    <p class="dtj-rotating-text__line">
      {%- if block.settings.prefix_text != blank -%}
        <span class="dtj-rotating-text__prefix">{{ block.settings.prefix_text | escape }}</span>{{ ' ' }}
      {%- endif -%}
      <span class="dtj-rotating-text__typed" data-typed>{{ rt_first | escape }}</span><span class="dtj-rotating-text__cursor" aria-hidden="true"></span>
    </p>
  </dtj-rotating-text>
{%- endif -%}
