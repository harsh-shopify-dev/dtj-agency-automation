                          assign n_icon = n_key
                          assign n_text = s_note | remove_first: n_bits[0] | remove_first: ':' | strip
                        endif
                      endif
                    -%}
                    <p class="dtj-sl__note">{%- if n_icon != blank -%}<span class="dtj-sl__icon">{% render 'dtj-sl-icon', name: n_icon %}</span>{%- endif -%}<span>{{ n_text | escape }}</span></p>
                  {%- endif -%}
                  <div class="dtj-sl__progress" aria-hidden="true"><i class="dtj-sl__fill"></i></div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if sl_n > 1 and bs.arrows_position != 'none' -%}
        <div class="dtj-sl__nav">
          <button type="button" class="dtj-sl__arrow dtj-sl__arrow--prev" data-dir="-1" aria-label="Previous slide"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg></button>
