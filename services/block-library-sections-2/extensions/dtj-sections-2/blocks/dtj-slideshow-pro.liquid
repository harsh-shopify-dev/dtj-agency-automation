{%- capture dtj_content -%}
{%- liquid
  assign sl_icons = ',leaf,shield,check,globe,heart,bolt,snowflake,bulb,brain,drop,sparkle,star,truck,clock,award,atom,'
  assign sl_n = 0
  assign sl_first = nil
  for i in (1..3)
    assign ik = 'image_' | append: i
    assign ek = 'eyebrow_' | append: i
    assign hk = 'heading_' | append: i
    assign rk = 'rating_' | append: i
    assign dk = 'description_' | append: i
    assign ck = 'chips_' | append: i
    assign bk = 'button_label_' | append: i
    assign nk = 'note_' | append: i
    assign has = false
    if bs[ik] != blank or bs[ek] != blank or bs[hk] != blank or bs[rk] != blank or bs[dk] != blank or bs[ck] != blank or bs[bk] != blank or bs[nk] != blank
      assign has = true
    endif
    if has
      assign sl_n = sl_n | plus: 1
      if sl_first == nil and bs[ik] != blank
        assign sl_first = bs[ik]
      endif
    endif
  endfor
  assign sl_rd = bs.ratio_desktop
  assign sl_rm = bs.ratio_mobile
  if sl_rd == 'adapt'
    assign sl_rd = sl_first.aspect_ratio | default: '3 / 2'
  endif
  if sl_rm == 'adapt'
    assign sl_rm = sl_first.aspect_ratio | default: '4 / 5'
  endif
