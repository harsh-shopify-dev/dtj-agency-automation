        </div>
      {%- endif -%}
    </div>
  </dtj-slideshow>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Slideshow Pro is empty. Add a picture or a heading to "Slide 1" (editor only: shoppers see nothing).</p>
{%- endif -%}
{%- endcapture -%}

