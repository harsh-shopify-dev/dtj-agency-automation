                      assign n_text = s_note
                      assign n_icon = ''
                      assign n_bits = s_note | split: ':'
                      if n_bits.size > 1
                        assign n_key = n_bits[0] | strip | downcase
                        assign n_probe = ',' | append: n_key | append: ','
