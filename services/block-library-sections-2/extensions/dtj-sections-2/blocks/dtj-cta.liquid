{%- comment -%} GENERATED by tools/build_blocks.py from manifests/cta.json and src/cta.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ bs.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ bs.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ bs.side_padding | default: 16 }}px; --dtj-pad-right: {{ bs.side_padding | default: 16 }}px; --dtj-align: {{ bs.align | default: 'start' }}; --dtj-justify: {% case bs.align %}{% when 'center' %}center{% when 'end' %}flex-end{% else %}flex-start{% endcase %}; {% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %}{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign cta_label = bs.button_label | strip
  assign cta_h = bs.heading | strip
  assign cta_t = bs.text | strip
  assign cta_seal = bs.seal_text | strip
  assign cta_banner = false
  if bs.style == 'banner'
    assign cta_banner = true
  endif
  assign cta_show = false
  if cta_label != blank
    assign cta_show = true
  endif
  if cta_banner and cta_h != blank
    assign cta_show = true
  endif
  assign cta_variant = nil
  if bs.action == 'cart' and product
    assign cta_v = product.selected_or_first_available_variant
    if cta_v and cta_v.available
      assign cta_variant = cta_v
    endif
  endif
  assign cta_shape = 'pill'
  case bs.button_style
    when 'rounded' or 'square'
      assign cta_shape = bs.button_style
  endcase
-%}
{%- if cta_show -%}
  <div class="dtj-b dtj-cta{% if cta_banner %} dtj-cta--banner{% endif %}{% if bs.full_width_mobile %} dtj-cta--fullm{% endif %}" style="{{ dtj_std_style | strip_newlines }} --cta-w: {{ bs.container_width }}px; --cta-h-d: {{ bs.heading_size_desktop }}px; --cta-h-m: {{ bs.heading_size_mobile }}px;{% if bs.button_bg != blank %} --cta-bg: {{ bs.button_bg }};{% endif %}{% if bs.button_color != blank %} --cta-fg: {{ bs.button_color }};{% endif %}{% if bs.heading_color != blank %} --cta-hc: {{ bs.heading_color }};{% endif %}{% if bs.seal_color != blank %} --cta-seal: {{ bs.seal_color }};{% endif %}" {{ block.shopify_attributes }}>
    <div class="dtj-cta__inner">
      {%- if cta_banner and cta_seal != blank -%}
        <span class="dtj-cta__seal"><span>{{ cta_seal | escape }}</span></span>
      {%- endif -%}
      {%- if cta_banner and cta_h != blank -%}
        <h2 class="dtj-cta__heading">{{ cta_h | escape }}</h2>
      {%- endif -%}
      {%- if cta_banner and cta_t != blank -%}
        <p class="dtj-cta__text">{{ cta_t | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if cta_label != blank -%}
        {%- if cta_variant -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="dtj-cta__form">
            <input type="hidden" name="id" value="{{ cta_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="dtj-cta__btn dtj-cta__btn--{{ cta_shape }}">{{ cta_label | escape }}</button>
          </form>
        {%- elsif bs.action == 'link' and bs.link != blank -%}
          <a class="dtj-cta__btn dtj-cta__btn--{{ cta_shape }}" href="{{ bs.link }}">{{ cta_label | escape }}</a>
        {%- else -%}
          <a class="dtj-cta__btn dtj-cta__btn--{{ cta_shape }}" href="#" data-dtj-cta-scroll>{{ cta_label | escape }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

