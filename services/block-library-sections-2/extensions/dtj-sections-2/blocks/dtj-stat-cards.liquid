lt":20},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":32,"step":1,"unit":"px","default":14},{"type":"checkbox","id":"card_shadow","label":"Soft shadow on cards","default":true},{"type":"range","id":"card_padding_desktop","label":"Card padding, desktop","min":16,"max":64,"step":2,"unit":"px","default":28},{"type":"range","id":"card_padding_mobile","label":"Card padding, phone","min":12,"max":40,"step":2,"unit":"px","default":22},{"type":"range","id":"number_size_desktop","label":"Figure size, desktop","min":28,"max":96,"step":2,"unit":"px","default":48},{"type":"range","id":"number_size_mobile","label":"Figure size, phone","min":24,"max":64,"step":2,"unit":"px","default":38},{"type":"range","id":"label_size","label":"Line size","min":13,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"note_size","label":"Footnote size","min":10,"max":16,"step":1,"unit":"px","default":12},{"type":"color","id":"card_bg","label":"Card background","info":"Empty = a soft tint of the accent color."},{"type":"color","id":"number_color","label":"Figure color","info":"Empty = the accent color."},{"type":"color","id":"label_color","label":"Line color","info":"Empty = same as the text."},{"type":"color","id":"note_color","label":"Footnote color","info":"Empty = a softer shade of the text."},{"type":"header","content":"Stats (up to 6)"},{"type":"text","id":"number_1","label":"Card 1: figure","info":"Only figures you can prove. A card shows when it has a figure, a line or a footnote."},{"type":"textarea","id":"label_1","label":"Card 1: line"},{"type":"textarea","id":"note_1","label":"Card 1: footnote","info":"Where the figure comes from, for example the study it is based on."},{"type":"text","id":"number_2","label":"Card 2: figure"},{"type":"textarea","id":"label_2","label":"Card 2: line"},{"type":"textarea","id":"note_2","label":"Card 2: footnote"},{"type":"text","id":"number_3","label":"Card 3: figure"},{"type":"textarea","id":"label_3","label":"Card 3: line"},{"type":"textarea","id":"note_3","label":"Card 3: footnote"},{"type":"text","id":"number_4","label":"Card 4: figure"},{"type":"textarea","id":"label_4","label":"Card 4: line"},{"type":"textarea","id":"note_4","label":"Card 4: footnote"},{"type":"text","id":"number_5","label":"Card 5: figure"},{"type":"textarea","id":"label_5","label":"Card 5: line"},{"type":"textarea","id":"note_5","label":"Card 5: footnote"},{"type":"text","id":"number_6","label":"Card 6: figure"},{"type":"textarea","id":"label_6","label":"Card 6: line"},{"type":"textarea","id":"note_6","label":"Card 6: footnote"},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}]}
{% endschema %}
