  "settings": [
    {
      "type": "header",
      "content": "Layout and picture overlay"
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Shape on desktop",
      "default": "3 / 2",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to the first picture"
        },
        {
          "value": "21 / 9",
          "label": "Ultra wide 21:9"
        },
        {
          "value": "16 / 9",
          "label": "Wide 16:9"
        },
        {
          "value": "3 / 2",
          "label": "Landscape 3:2"
        },
        {
          "value": "4 / 3",
          "label": "Classic 4:3"
        },
        {
          "value": "1 / 1",
          "label": "Square 1:1"
        }
      ],
      "info": "Adapt = the slider takes the shape of the first slide's picture. A tall text block never gets cut: the slide grows instead."
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Picture shape on phones",
      "default": "4 / 5",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to the first picture"
        },
        {
          "value": "1 / 1",
          "label": "Square 1:1"
        },
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        },
        {
          "value": "3 / 4",
          "label": "Tall 3:4"
        },
        {
          "value": "4 / 3",
          "label": "Landscape 4:3"
        },
        {
          "value": "16 / 9",
          "label": "Wide 16:9"
        }
      ],
      "info": "Adapt = the phone picture's own shape; with no phone picture the overlay layout uses a tall 4:5 so a wide picture is never shown as a thin strip."
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Phone layout",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "Text above the picture"
        },
        {
          "value": "overlay",
          "label": "Text on the picture (tall picture, text low on it)"
        }
      ],
      "info": "Overlay = the picture fills the slide and the words rest on its lower part over a fade (use it with a tall phone picture). Stack = the words sit above the picture (the original look)."
    },
    {
      "type": "select",
      "id": "mobile_align",
      "label": "Text alignment on phones",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (left on the picture, centre above it)"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_pic_space",
      "label": "Picture showing above the text (phones)",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "vw",
      "default": 50,
      "info": "Only for the overlay layout: how much picture stays clear above the words."
    },
    {
      "type": "range",
      "id": "desktop_max_height",
      "label": "Tallest the slide may be on desktop (% of screen height)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "0 = no limit (the slide follows its picture's shape). A tall collage can fill the whole screen; 70 keeps it to about two thirds and crops the picture to fit. Never shorter than 440px so the words always fit."
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Slider width (largest)",
      "min": 800,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1340
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text side (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text height (desktop)",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
