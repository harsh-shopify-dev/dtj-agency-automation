{
  "id": "split-story",
  "title": "DTJ Split Story Card",
  "block_file": "extensions/dtj-sections-2/blocks/dtj-split-story.liquid",
  "placements": [
    "product",
    "home"
  ],
  "licence": true,
  "min_filled_slots": 1,
  "css_includes": [],
  "slots": [
    {
      "id": "heading",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "heading_accent",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "body",
      "type": "textarea",
      "required": false,
      "max_length": 600
    },
    {
      "id": "bullet_1",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "bullet_2",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "bullet_3",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "bullet_4",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "bullet_5",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "review_text",
      "type": "textarea",
      "required": false,
      "max_length": 600
    },
    {
      "id": "review_name",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "review_image",
      "type": "image_picker",
      "required": false
    },
    {
      "id": "image",
      "type": "image_picker",
      "required": false
    }
  ],
  "standard_controls": [
    "spacing_v",
    "gutter",
    "colors"
  ],
  "standard_defaults": {
    "padding_top": 24,
    "padding_bottom": 24,
    "side_padding": 16
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading, first part",
      "info": "Empty = hidden."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, second part",
      "info": "Continues the heading in the accent color. Empty = hidden."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Paragraph",
      "info": "Empty = hidden."
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Check point 1",
      "info": "A point only shows when it has text."
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Check point 2"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Check point 3"
    },
    {
      "type": "text",
      "id": "bullet_4",
      "label": "Check point 4"
    },
    {
      "type": "text",
      "id": "bullet_5",
      "label": "Check point 5"
    },
    {
      "type": "header",
      "content": "Review card"
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review",
      "info": "Only a review you really have, in the customer's own words. Empty = no card."
    },
    {
      "type": "text",
      "id": "review_name",
      "label": "Reviewer name"
    },
    {
      "type": "select",
      "id": "review_stars",
      "label": "Stars",
      "default": "0",
      "options": [
        {
          "value": "0",
          "label": "No stars"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "info": "Only the rating the customer really gave."
    },
    {
      "type": "image_picker",
      "id": "review_image",
      "label": "Reviewer photo",
      "info": "Small and round. Empty = no photo."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Its description (Content, Files) is read aloud for screen readers."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side (wide screens)",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image shape",
      "default": "fill",
      "options": [
        {
          "value": "fill",
          "label": "Fill the side (crops the edges)"
        },
        {
          "value": "adapt",
          "label": "Adapt to the image (never crops)"
        }
      ],
      "info": "Adapt shows the whole picture at its own shape, on every screen; the card follows the picture. Use it for pictures with text or a product near the edges."
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width, desktop",
      "min": 30,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_min_height",
      "label": "Minimum height, desktop",
      "min": 240,
      "max": 760,
      "step": 10,
      "unit": "px",
      "default": 380
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Image shape on phones",
      "default": "4 / 3",
      "options": [
        {
          "value": "16 / 9",
          "label": "Wide (16:9)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Image focus",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Which part of the picture stays visible when it is cropped."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ],
      "info": "For search engines."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size, desktop",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size, phone",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Text size, desktop",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Text size, phone",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Empty = same as the text."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Second part of the heading, check marks and stars. Empty = same as the text."
    },
    {
      "type": "color",
      "id": "tick_color",
      "label": "Check mark color",
      "info": "The check inside the round point markers. Empty = the page background. Set it when the markers are a light color."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Paragraph color",
      "info": "Empty = a softer shade of the text."
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel background",
      "info": "The tinted side. Empty = a soft tint of the text color."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Review card background",
      "info": "Empty = the page background."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "panel_padding_desktop",
      "label": "Panel padding, desktop",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "Panel padding, phone",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "data_needs": [],
  "reference_image": null,
  "test": {
    "sample": {
      "heading": "Heading sample",
      "heading_accent": "Accent sample",
      "body": "Paragraph sample",
      "bullet_1": "Point one",
      "bullet_2": "Point two",
      "review_text": "Review sample",
      "review_name": "Reviewer sample",
      "image": "SWATCH"
    },
    "expect": [
      "Heading sample",
      "Accent sample",
      "Paragraph sample",
      "Point one",
      "Point two",
      "Review sample",
      "Reviewer sample",
      "dtj-ss__card",
      "dtj-ss__media"
    ]
  }
}
