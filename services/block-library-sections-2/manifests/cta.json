{
  "id": "cta",
  "title": "DTJ Call To Action",
  "block_file": "extensions/dtj-sections-2/blocks/dtj-cta.liquid",
  "placements": [
    "product",
    "home"
  ],
  "licence": true,
  "min_filled_slots": 1,
  "css_includes": [],
  "script": true,
  "slots": [
    {"id": "heading", "type": "text", "required": false, "max_length": 120},
    {"id": "text", "type": "textarea", "required": false, "max_length": 400},
    {"id": "seal_text", "type": "text", "required": false, "max_length": 40},
    {"id": "button_label", "type": "text", "required": false, "max_length": 40}
  ],
  "standard_controls": [
    "spacing_v",
    "gutter",
    "align",
    "colors"
  ],
  "standard_defaults": {
    "padding_top": 24,
    "padding_bottom": 24,
    "side_padding": 16,
    "align": "center"
  },
  "settings": [
    {"type": "header", "content": "Content"},
    {"type": "select", "id": "style", "label": "Style", "default": "button", "options": [
      {"value": "button", "label": "Button only (after a section)"},
      {"value": "banner", "label": "Banner: heading, text, seal, button"}
    ]},
    {"type": "text", "id": "heading", "label": "Banner heading", "info": "Banner style only. Empty = hidden."},
    {"type": "textarea", "id": "text", "label": "Banner text", "info": "Banner style only: the terms, e.g. how the guarantee works. Empty = hidden."},
    {"type": "text", "id": "seal_text", "label": "Seal text", "info": "Banner style only: a round seal, e.g. '30-day promise'. Empty = no seal."},
    {"type": "text", "id": "button_label", "label": "Button label", "info": "Empty = no button."},
    {"type": "select", "id": "action", "label": "Button action", "default": "scroll", "options": [
      {"value": "scroll", "label": "Scroll to the add to cart button"},
      {"value": "cart", "label": "Add this product to the cart"},
      {"value": "link", "label": "Open a link"}
    ], "info": "Add to cart works on a product page with one available variant; otherwise the button scrolls."},
    {"type": "url", "id": "link", "label": "Link", "info": "Only for 'Open a link'."},
    {"type": "header", "content": "Look"},
    {"type": "select", "id": "button_style", "label": "Button shape", "default": "pill", "options": [
      {"value": "pill", "label": "Pill"},
      {"value": "rounded", "label": "Rounded"},
      {"value": "square", "label": "Square"}
    ]},
    {"type": "color", "id": "button_bg", "label": "Button color", "info": "Empty = the text color."},
    {"type": "color", "id": "button_color", "label": "Button text color", "info": "Empty = the page background color."},
    {"type": "checkbox", "id": "full_width_mobile", "label": "Full-width button on phones", "default": true},
    {"type": "color", "id": "heading_color", "label": "Heading color", "info": "Empty = the text color."},
    {"type": "color", "id": "seal_color", "label": "Seal color", "info": "Empty = the text color."},
    {"type": "range", "id": "heading_size_desktop", "label": "Heading size, desktop", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 40},
    {"type": "range", "id": "heading_size_mobile", "label": "Heading size, phones", "min": 20, "max": 44, "step": 1, "unit": "px", "default": 30},
    {"type": "range", "id": "container_width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 900}
  ],
  "data_needs": [],
  "reference_image": "ThrillX wireframe (Figma 2460-4368): 'Shop now' / 'Main action to take' after sections, and the Money Back Guarantee band",
  "test": {
    "sample": {"style": "banner", "heading": "Heading sample", "text": "Text sample", "seal_text": "SEAL", "button_label": "Button sample"},
    "expect": ["Heading sample", "Text sample", "SEAL", "Button sample", "dtj-cta__btn", "data-dtj-cta-scroll"]
  }
}
