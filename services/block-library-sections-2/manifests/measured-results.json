  "settings": [
    {
      "type": "header",
      "content": "Panel"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "panel_padding_desktop",
      "label": "Panel padding, desktop",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "panel_padding_mobile",
      "label": "Panel padding, phone",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between the two sides",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Picture card (left)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture",
      "info": "Fills the card. Empty = a plain tinted card."
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "Picture focus",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Card height",
      "min": 280,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "image_overlay",
      "label": "Put the card text over the picture",
      "default": false,
      "info": "Off = the picture sits below the text, so the two never overlap. On = the picture fills the whole card and the text sits on top of it (use a picture with empty space at the top)."
    },
    {
      "type": "checkbox",
      "id": "card_scrim",
      "label": "Soft light haze behind the card text",
      "default": false,
      "info": "Only when the text is over the picture. Helps the text stay readable."
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card heading, first part"
    },
    {
      "type": "text",
      "id": "card_heading_accent",
      "label": "Card heading, italic part",
      "info": "Continues the heading in italics. Empty = hidden."
    },
    {
      "type": "text",
      "id": "card_subline",
      "label": "Card line under the heading"
    },
    {
      "type": "text",
      "id": "card_figure",
      "label": "Card big figure",
      "info": "Only a figure you can prove, for example from a study. Empty = hidden."
    },
    {
      "type": "text",
      "id": "card_figure_label",
      "label": "Card figure caption"
    },
    {
      "type": "range",
      "id": "card_heading_size_desktop",
      "label": "Card heading size, desktop",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "card_heading_size_mobile",
      "label": "Card heading size, phone",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text color",
      "info": "Empty = dark."
    },
    {
      "type": "color",
      "id": "card_accent_color",
      "label": "Card figure color",
      "info": "Empty = same as the card text."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "info": "Shows when there is no picture, or behind a transparent one."
    },
    {
      "type": "header",
      "content": "Right side"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading, first part"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, accent part",
      "info": "Continues the heading in the accent color. Empty = hidden."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ],
      "info": "For search engines."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size, desktop",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
