    {
      "type": "header",
      "content": "Version and motion"
    },
    {
      "type": "select",
      "id": "variation",
      "label": "Version",
      "default": "line",
      "options": [
        {
          "value": "line",
          "label": "Light band: line icons and plain words"
        },
        {
          "value": "dark",
          "label": "Dark band: line icons and plain words"
        },
        {
          "value": "bold",
          "label": "Bold band: chunky capitals and emoji"
        }
      ],
      "info": "Each version sets its own size, spacing and lines. Every number below can be changed."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds for one pass",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 40,
      "unit": "s",
      "info": "Longer = slower."
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Moves",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "To the left"
        },
        {
          "value": "right",
          "label": "To the right"
        }
      ]
    },
    {
      "type": "range",
      "id": "repeat",
      "label": "Times the items repeat in a row",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3,
      "info": "Raise it if the band shows a gap on a wide screen."
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Stops when the pointer is over it",
      "default": true
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Words size",
      "min": 0,
      "max": 56,
      "step": 1,
      "default": 0,
      "unit": "px",
      "info": "0 = the version's own size: 15 for the light and dark bands, 34 for the bold band."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "unit": "px",
      "info": "0 = the version's own space."
    },
    {
      "type": "select",
      "id": "font_style",
      "label": "Words style",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (bold band chunky capitals)"
        },
        {
          "value": "theme",
          "label": "Theme font"
        },
        {
          "value": "heavy",
          "label": "Chunky capitals"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 0,
      "unit": "px",
      "info": "0 = the version's own size."
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Line icon color",
      "info": "Empty = the text color."
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color above and below",
      "info": "Empty = the version's own line."
    },
    {
      "type": "checkbox",
      "id": "show_lines",
      "label": "Lines above and below",
      "default": true
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Line thickness",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0,
      "unit": "px",
      "info": "0 = the version's own thickness."
    }
