{
  "id": "best-sellers",
  "title": "DTJ Best Sellers",
  "block_file": "extensions/dtj-commerce/blocks/dtj-best-sellers.liquid",
  "placements": [
    "home"
  ],
  "licence": true,
  "min_filled_slots": 1,
  "css_includes": [],
  "script": true,
  "slots": [
    {
      "id": "heading",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "tab_1",
      "type": "text",
      "required": false,
      "max_length": 40
    },
    {
      "id": "tab_2",
      "type": "text",
      "required": false,
      "max_length": 40
    },
    {
      "id": "tab_3",
      "type": "text",
      "required": false,
      "max_length": 40
    },
    {
      "id": "tab_4",
      "type": "text",
      "required": false,
      "max_length": 40
    },
    {
      "id": "tab_5",
      "type": "text",
      "required": false,
      "max_length": 40
    }
  ],
  "standard_controls": [
    "spacing_v",
    "gutter",
    "colors"
  ],
  "standard_defaults": {
    "padding_top": 32,
    "padding_bottom": 32,
    "side_padding": 16
  },
  "settings": [
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = hidden."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h3",
          "label": "h3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Tabs and products"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections (one tab each)",
      "limit": 5,
      "info": "Each collection becomes a tab and shows its own products. One collection = no tabs, just the row."
    },
    {
      "type": "text",
      "id": "tab_1",
      "label": "Tab 1: name",
      "info": "Empty = the collection name."
    },
    {
      "type": "text",
      "id": "tab_2",
      "label": "Tab 2: name"
    },
    {
      "type": "text",
      "id": "tab_3",
      "label": "Tab 3: name"
    },
    {
      "type": "text",
      "id": "tab_4",
      "label": "Tab 4: name"
    },
    {
      "type": "text",
      "id": "tab_5",
      "label": "Tab 5: name"
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "label": "Products per tab",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "badge_tags",
      "label": "Badge tags",
      "info": "Product tags to show as a badge, most important first, separated by commas, e.g. bestseller, trending, new. A product shows the first one it carries, with the tag's own words. Empty = no tag badges."
    },
    {
      "type": "checkbox",
      "id": "sale_badge",
      "label": "Sale badge on reduced products without a badge tag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show the old price when a product is on sale",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "swatches",
      "label": "Show variants under the name",
      "default": true,
      "info": "Picture swatches (or words) for the first option. Pressing one changes the picture, price and cart variant in the card. A product without variants shows nothing."
    },
    {
      "type": "select",
      "id": "multi_option",
      "label": "A product with more than one option",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "The button opens the product page"
        },
        {
          "value": "first",
          "label": "Add the first available option of the swatch"
        }
      ],
      "info": "Size and color together cannot be chosen in a small card."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show the star rating",
      "default": true,
      "info": "Read from Judge.me (its product badge, or the standard review ratings). A product with no reviews shows no rating."
    },
    {
      "type": "checkbox",
      "id": "demo_ratings",
      "label": "Show sample ratings in the theme editor only",
      "default": true,
      "info": "Lets you see the finished card before reviews exist. Shoppers NEVER see sample ratings: on the store a product without reviews shows no rating."
    },
    {
      "type": "checkbox",
      "id": "wishlist",
      "label": "Heart button on the picture",
      "default": false,
      "info": "Saves favourites in the visitor's own browser only (no account, no sync)."
    },
    {
      "type": "checkbox",
      "id": "gallery",
      "label": "Swipe through up to 4 pictures in the card",
      "default": false,
      "info": "Dots show which picture is in view."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "outline",
      "options": [
        {
          "value": "outline",
          "label": "Outlined card"
        },
        {
          "value": "soft",
          "label": "Soft card with a shadow"
        },
        {
          "value": "tinted",
          "label": "Tinted card"
        },
        {
          "value": "plain",
          "label": "No box"
        }
      ]
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Cart button",
      "default": "bar",
      "options": [
        {
          "value": "bar",
          "label": "Bar with the price"
        },
        {
          "value": "button",
          "label": "Full-width button, price above"
        },
        {
          "value": "none",
          "label": "No button, price only"
        }
      ],
      "info": "A one-variant product is added in place; a product with options follows the setting above."
    },
    {
      "type": "select",
      "id": "button_shape",
      "label": "Button corners",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        }
      ],
      "info": "Both are regular rectangles, never an oval."
    },
    {
      "type": "select",
      "id": "tab_style",
      "label": "Tab style",
      "default": "boxed",
      "options": [
        {
          "value": "boxed",
          "label": "Boxes with a dashed outline"
        },
        {
          "value": "pill",
          "label": "Pills"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ]
    },
    {
      "type": "range",
      "id": "visible_desktop",
      "label": "Products in view on desktop",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "default": 4,
      "info": "A half card at the edge shows there is more to swipe."
    },
    {
      "type": "range",
      "id": "visible_mobile",
      "label": "Products in view on phones",
      "min": 1.5,
      "max": 3,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 6,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture shape",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        },
        {
          "value": "0.75",
          "label": "Portrait 3:4"
        },
        {
          "value": "1.25",
          "label": "Landscape 5:4"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Picture fit",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "Show the whole product"
        },
        {
          "value": "cover",
          "label": "Fill the box (crops)"
        }
      ]
    },
    {
      "type": "range",
      "id": "swatch_size",
      "label": "Swatch size",
      "min": 20,
      "max": 44,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_lines",
      "label": "Product name lines",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "default": 1400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme heading font"
        },
        {
          "value": "serif",
          "label": "Serif"
        },
        {
          "value": "sans",
          "label": "Clean sans"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size, desktop",
      "min": 20,
      "max": 72,
      "step": 1,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size, phones",
      "min": 18,
      "max": 44,
      "step": 1,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Product name font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme font"
        },
        {
          "value": "serif",
          "label": "Serif"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "The active tab, the cart button, the badge and the rating. Empty = the text color."
    },
    {
      "type": "color",
      "id": "accent_text",
      "label": "Text on the accent color",
      "info": "Empty = the background color."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card color",
      "info": "For the Tinted style. Empty = a soft tint of the text color."
    },
    {
      "type": "checkbox",
      "id": "badge_caps",
      "label": "Badge words in capitals",
      "default": true
    },
    {
      "type": "select",
      "id": "arrows",
      "label": "Arrows",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Squares"
        },
        {
          "value": "circle",
          "label": "Circles"
        },
        {
          "value": "none",
          "label": "No arrows (swipe only)"
        }
      ]
    },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to the cart",
      "default": "stay",
      "options": [
        {
          "value": "stay",
          "label": "Stay here and confirm on the button"
        },
        {
          "value": "cart",
          "label": "Go to the cart page"
        }
      ]
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Cart button words",
      "info": "Empty = Quick add."
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Words after adding",
      "info": "Empty = Added."
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Words for a product with options",
      "info": "Empty = Choose options."
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Words for a sold-out product",
      "info": "Empty = Sold out."
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Words on the sale badge",
      "info": "Empty = Sale."
    }
  ],
  "data_needs": [],
