{
  "id": "category-grid",
  "title": "DTJ Category Grid",
  "block_file": "extensions/dtj-commerce/blocks/dtj-category-grid.liquid",
  "placements": [
    "home"
  ],
  "licence": true,
  "min_filled_slots": 1,
  "css_includes": [],
  "slots": [
    {
      "id": "heading",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "subheading",
      "type": "text",
      "required": false,
      "max_length": 120
    },
    {
      "id": "title_1",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "button_1",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "title_2",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "button_2",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "title_3",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "button_3",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "title_4",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "button_4",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "title_5",
      "type": "text",
      "required": false,
      "max_length": 60
    },
    {
      "id": "button_5",
      "type": "text",
      "required": false,
      "max_length": 60
    }
  ],
  "standard_controls": [
    "spacing_v",
    "gutter",
    "colors"
  ],
  "standard_defaults": {
    "padding_top": 32,
    "padding_bottom": 32,
    "side_padding": 16
  },
  "settings": [
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = hidden."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Empty = hidden."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h3",
          "label": "h3"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centred"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "header",
      "content": "Tiles (up to 5)"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections (one per tile, in order)",
      "limit": 5,
      "info": "The first collection becomes tile 1, the second tile 2, and so on: each gives its tile a link, a name and a picture. Everything in the tiles below is optional and overrides it."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Tile 1: picture",
      "info": "Empty = the collection's own picture."
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Tile 1: title",
      "info": "Empty = the collection name."
    },
    {
      "type": "text",
      "id": "button_1",
      "label": "Tile 1: button label",
      "info": "e.g. Shop throws. Empty = no button (the title is the link)."
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Tile 1: link",
      "info": "Empty = the collection's page."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Tile 2: picture"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Tile 2: title"
    },
    {
      "type": "text",
      "id": "button_2",
      "label": "Tile 2: button label"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Tile 2: link"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Tile 3: picture"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Tile 3: title"
    },
    {
      "type": "text",
      "id": "button_3",
      "label": "Tile 3: button label"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Tile 3: link"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Tile 4: picture"
    },
    {
      "type": "text",
      "id": "title_4",
      "label": "Tile 4: title"
    },
    {
      "type": "text",
      "id": "button_4",
      "label": "Tile 4: button label"
    },
    {
      "type": "url",
      "id": "link_4",
      "label": "Tile 4: link"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Tile 5: picture"
    },
    {
      "type": "text",
      "id": "title_5",
      "label": "Tile 5: title"
    },
    {
      "type": "text",
      "id": "button_5",
      "label": "Tile 5: button label"
    },
    {
      "type": "url",
      "id": "link_5",
      "label": "Tile 5: link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "bento_left",
      "options": [
        {
          "value": "bento_left",
          "label": "Big tile on the left, four on the right"
        },
        {
          "value": "bento_right",
          "label": "Four on the left, tall tile on the right"
        },
        {
          "value": "even",
          "label": "Even grid"
        }
      ],
      "info": "The two big layouts need exactly 5 tiles; with fewer or more the grid turns even."
    },
    {
      "type": "select",
      "id": "tile_shape",
      "label": "Shape of the small tiles",
      "default": "1.6",
      "options": [
        {
          "value": "2.16",
          "label": "Wide 2.2:1"
        },
        {
          "value": "1.6",
          "label": "Landscape 3:2"
        },
        {
          "value": "1.05",
          "label": "Almost square"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        }
      ],
      "info": "Width divided by height. The big tile stretches to match."
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between tiles",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "tile_radius",
      "label": "Tile corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "This section is at the top of the page",
      "default": false,
      "info": "Loads the first picture first. Leave off for a section further down."
    },
    {
      "type": "header",
      "content": "Look"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark tint on the pictures",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15,
      "info": "Keeps the words readable on a bright picture."
    },
    {
      "type": "select",
      "id": "caption_position",
      "label": "Words sit",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Near the bottom"
        },
        {
          "value": "middle",
          "label": "In the middle"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "feature_middle",
      "label": "Words of the big tile in the middle",
      "default": false,
      "info": "Only for the big or tall tile of the two big layouts."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "info": "Empty = white."
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title size, desktop",
      "min": 14,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size, phones",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button color",
      "info": "Empty = the page background color."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button text color",
      "info": "Empty = the page text color."
    },
    {
      "type": "select",
      "id": "button_shape",
      "label": "Button corners",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        }
      ],
      "info": "Both are regular rectangles, never an oval."
    }
  ],
  "data_needs": [],
  "reference_image": "Media Grid #2 (Harsh, 13 Oct 2026): five picture tiles with a centred title and a small capitals button, a big tile on one side and four on the other",
  "test": {
    "sample": {
      "heading": "Heading sample",
      "subheading": "Sub sample",
      "collections": [
        {
          "title": "Coll one",
          "url": "/collections/c1",
          "image": "cpic1"
        },
        {
          "title": "Coll two",
          "url": "/collections/c2"
        }
      ],
      "title_1": "Tile one",
      "button_1": "Shop one",
      "link_1": "/collections/one",
      "image_1": "pic1",
      "title_2": "Tile two",
      "button_2": "Shop two",
      "link_2": "/collections/two",
      "image_2": "pic2",
      "title_3": "Tile three",
      "link_3": "/collections/three",
      "image_3": "pic3",
      "title_4": "Tile four",
      "image_4": "pic4",
      "title_5": "Tile five",
      "image_5": "pic5"
    },
    "expect": [
      "Heading sample",
      "Sub sample",
      "Tile one",
      "Shop one",
      "Tile two",
      "Tile three",
      "Tile four",
      "Tile five",
      "dtj-cg__tile",
      "/collections/one"
    ]
  }
}
