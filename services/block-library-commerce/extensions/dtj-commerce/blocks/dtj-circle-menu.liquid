 6: link"},{"type":"image_picker","id":"image_7","label":"Tile 7: picture"},{"type":"text","id":"title_7","label":"Tile 7: name"},{"type":"url","id":"link_7","label":"Tile 7: link"},{"type":"image_picker","id":"image_8","label":"Tile 8: picture"},{"type":"text","id":"title_8","label":"Tile 8: name"},{"type":"url","id":"link_8","label":"Tile 8: link"},{"type":"header","content":"Version and layout"},{"type":"select","id":"variation","label":"Version","default":"ring","options":[{"value":"ring","label":"Story rings: small circles with a colored ring, no names"},{"value":"circle","label":"Large circles with names below"},{"value":"square","label":"Framed squares with names below"}],"info":"Each version sets its own size, spacing, names and phone layout. Every number below can be changed."},{"type":"range","id":"tile_size","label":"Tile size on desktop","min":0,"max":260,"step":4,"default":0,"unit":"px","info":"0 = the version's own size: 100 for rings, 184 for circles, 112 for squares."},{"type":"range","id":"tile_size_mobile","label":"Tile size on phones","min":0,"max":180,"step":4,"default":0,"unit":"px","info":"0 = the version's own size: 72 for rings, 104 for circles, 84 for squares."},{"type":"range","id":"gap","label":"Space between tiles","min":0,"max":80,"step":2,"default":0,"unit":"px","info":"0 = the version's own space."},{"type":"select","id":"mobile_layout","label":"Phone layout","default":"auto","options":[{"value":"auto","label":"Automatic (rings scroll, the others wrap)"},{"value":"scroll","label":"One row that scrolls sideways"},{"value":"wrap","label":"Wrap onto several rows"}]},{"type":"select","id":"labels","label":"Names","default":"auto","options":[{"value":"auto","label":"Automatic (rings none, the others below)"},{"value":"show","label":"Show below the picture"},{"value":"hide","label":"Hide"}]},{"type":"range","id":"container_width","label":"Maximum width","min":480,"max":1920,"step":20,"default":1200,"unit":"px"},{"type":"checkbox","id":"hover_zoom","label":"Picture grows a little on hover","default":true},{"type":"checkbox","id":"priority","label":"This section is at the top of the page","default":false,"info":"Loads the pictures first. Leave off for a section further down."},{"type":"header","content":"Look"},{"type":"color","id":"bg_color_2","label":"Background: second color","info":"With the background color above it makes a soft top-to-bottom gradient. Empty = flat."},{"type":"range","id":"heading_size_desktop","label":"Heading size, desktop","min":20,"max":72,"step":1,"default":44,"unit":"px"},{"type":"range","id":"heading_size_mobile","label":"Heading size, phones","min":18,"max":44,"step":1,"default":28,"unit":"px"},{"type":"select","id":"label_font","label":"Name font","default":"theme","options":[{"value":"theme","label":"Theme font"},{"value":"mono","label":"Typewriter"},{"value":"serif","label":"Serif"}]},{"type":"range","id":"label_size","label":"Name size","min":11,"max":22,"step":1,"default":14,"unit":"px"},{"type":"range","id":"ring_width","label":"Ring thickness (rings)","min":1,"max":8,"step":1,"default":3,"unit":"px"},{"type":"color","id":"ring_color_1","label":"Ring color 1","info":"The ring is a gradient of up to three colors. Empty = orange."},{"type":"color","id":"ring_color_2","label":"Ring color 2","info":"Empty = hot pink."},{"type":"color","id":"ring_color_3","label":"Ring color 3","info":"Empty = purple."},{"type":"color","id":"frame_color","label":"Frame color (squares)","info":"Empty = a soft shade of the text color."},{"type":"range","id":"frame_width","label":"Frame thickness (squares)","min":0,"max":8,"step":1,"default":2,"unit":"px"},{"type":"range","id":"corner_radius","label":"Corner radius (squares)","min":0,"max":32,"step":2,"default":0,"unit":"px"},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}]}
