{%- comment -%} GENERATED by tools/build_blocks.py from manifests/wave-divider.json and src/wave-divider.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}{% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %}{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign wv_color = bs.wave_color
  assign wv_style = bs.style | default: 'single'
  assign wv_layers = 1
  if wv_style == 'layered'
    assign wv_layers = bs.layers | default: 4 | plus: 0
  endif
  assign wv_anim = false
  if bs.animate
    assign wv_anim = true
  endif
  assign wv_periods = 1
  if wv_anim
    assign wv_periods = 2
  endif
  assign wv_amp = bs.wave_depth | default: 40 | times: 0.5
  assign wv_width = 1200 | times: wv_periods
  assign wv_speed = bs.speed | default: 14 | plus: 0
-%}
{%- if wv_color != blank -%}
  <div class="dtj-b dtj-wv{% if bs.flip %} dtj-wv--flip{% endif %}{% if wv_anim %} dtj-wv--drift{% endif %}" aria-hidden="true" style="{{ dtj_std_style | strip_newlines }} --wv-color: {{ wv_color | escape }}; --wv-h-d: {{ bs.wave_height }}px; --wv-h-m: {{ bs.wave_height_mobile }}px; --wv-pull: {{ bs.pull }}px; --wv-periods: {{ wv_periods }};" {{ block.shopify_attributes }}>
    {%- for l in (1..wv_layers) -%}
      {%- liquid
        # each layer is its own wave: a different number of humps, a different baseline and strength, so the copies cross as they drift
        assign n = bs.waves | default: 6 | plus: 0
        if wv_layers > 1
          assign n = n | plus: l | minus: 1
        endif
        assign hw = 1200.0 | divided_by: n
        assign mid = 50
        assign op = 1
        if wv_layers > 1
          assign mid = l | minus: 1 | times: 7 | plus: 34
          assign op = l | times: 1.0 | divided_by: wv_layers
        endif
        assign y_ctl = mid | minus: wv_amp | minus: wv_amp
        assign hh = hw | divided_by: 2 | round: 1
        assign hw = hw | round: 1
        assign d = 'M0 100 L0 ' | append: mid | append: ' Q ' | append: hh | append: ' ' | append: y_ctl | append: ' ' | append: hw | append: ' ' | append: mid
        assign total = n | times: wv_periods
        for k in (2..total)
          assign xk = 1200.0 | divided_by: n | times: k | round: 1
          assign d = d | append: ' T ' | append: xk | append: ' ' | append: mid
        endfor
        assign d = d | append: ' L ' | append: wv_width | append: ' 100 Z'
        assign dur = l | minus: 1 | times: 0.35 | plus: 1 | times: wv_speed
        assign parity = l | modulo: 2
      -%}
      <svg class="dtj-wv__svg{% if parity == 0 %} dtj-wv__svg--rev{% endif %}" viewBox="0 0 {{ wv_width }} 100" preserveAspectRatio="none" focusable="false" style="--wv-op: {{ op | round: 2 }}; --wv-dur: {{ dur | round: 1 }}s;"><path d="{{ d }}"/></svg>
    {%- endfor -%}
  </div>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Wave Divider is empty. Pick the wave color (the color of the section below the wave). Editor only: shoppers see nothing.</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

{% schema %}
{"name":"DTJ Wave Divider","target":"section","stylesheet":"dtj-wave-divider.css","settings":[{"type":"header","content":"Colors"},{"type":"color","id":"wave_color","label":"Wave color","info":"The color BELOW the wave: use the color of the section that follows. Nothing shows until you pick one. The color above the wave is the background color below."},{"type":"header","content":"Wave"},{"type":"select","id":"style","label":"Style","default":"single","options":[{"value":"single","label":"Single wave"},{"value":"layered","label":"Layered waves (see-through, drifting)"}]},{"type":"range","id":"waves","label":"Waves across the screen","min":2,"max":16,"step":1,"default":6,"info":"More waves = a tighter ripple. Layered copies use a slightly different count each, which makes them cross."},{"type":"range","id":"wave_depth","label":"How deep the wave is","min":10,"max":60,"step":5,"default":40,"unit":"%","info":"The height of the crests and troughs as a share of the band."},{"type":"range","id":"layers","label":"Layers (layered style)","min":2,"max":4,"step":1,"default":4},{"type":"range","id":"wave_height","label":"Band height on desktop","min":40,"max":400,"step":10,"default":120,"unit":"px"},{"type":"range","id":"wave_height_mobile","label":"Band height on phones","min":30,"max":240,"step":10,"default":80,"unit":"px"},{"type":"checkbox","id":"flip","label":"Turn upside down","default":false,"info":"Puts the wave color above and the background color below."},{"type":"range","id":"pull","label":"Pull up over the section above","min":0,"max":120,"step":4,"default":0,"unit":"px","info":"Tucks the band under the section above so no thin line shows between them."},{"type":"header","content":"Motion"},{"type":"checkbox","id":"animate","label":"Waves drift sideways","default":true,"info":"Stands still for visitors who ask their device for less motion."},{"type":"range","id":"speed","label":"Seconds for one pass","min":4,"max":40,"step":1,"default":14,"unit":"s"},{"type":"header","content":"Style and spacing"},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}]}
{% endschema %}
