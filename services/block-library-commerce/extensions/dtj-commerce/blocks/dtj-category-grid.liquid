utton_4","label":"Tile 4: button label"},{"type":"url","id":"link_4","label":"Tile 4: link"},{"type":"image_picker","id":"image_5","label":"Tile 5: picture"},{"type":"text","id":"title_5","label":"Tile 5: title"},{"type":"text","id":"button_5","label":"Tile 5: button label"},{"type":"url","id":"link_5","label":"Tile 5: link"},{"type":"header","content":"Layout"},{"type":"select","id":"layout","label":"Layout","default":"bento_left","options":[{"value":"bento_left","label":"Big tile on the left, four on the right"},{"value":"bento_right","label":"Four on the left, tall tile on the right"},{"value":"even","label":"Even grid"}],"info":"The two big layouts need exactly 5 tiles; with fewer or more the grid turns even."},{"type":"select","id":"tile_shape","label":"Shape of the small tiles","default":"1.6","options":[{"value":"2.16","label":"Wide 2.2:1"},{"value":"1.6","label":"Landscape 3:2"},{"value":"1.05","label":"Almost square"},{"value":"0.8","label":"Portrait 4:5"}],"info":"Width divided by height. The big tile stretches to match."},{"type":"range","id":"container_width","label":"Maximum width","min":600,"max":1920,"step":20,"unit":"px","default":1400},{"type":"range","id":"gap","label":"Space between tiles","min":4,"max":32,"step":2,"unit":"px","default":16},{"type":"range","id":"tile_radius","label":"Tile corner radius","min":0,"max":32,"step":2,"unit":"px","default":0},{"type":"checkbox","id":"priority","label":"This section is at the top of the page","default":false,"info":"Loads the first picture first. Leave off for a section further down."},{"type":"header","content":"Look"},{"type":"range","id":"overlay","label":"Dark tint on the pictures","min":0,"max":60,"step":5,"unit":"%","default":15,"info":"Keeps the words readable on a bright picture."},{"type":"select","id":"caption_position","label":"Words sit","default":"bottom","options":[{"value":"bottom","label":"Near the bottom"},{"value":"middle","label":"In the middle"}]},{"type":"checkbox","id":"feature_middle","label":"Words of the big tile in the middle","default":false,"info":"Only for the big or tall tile of the two big layouts."},{"type":"color","id":"title_color","label":"Title color","info":"Empty = white."},{"type":"range","id":"title_size_desktop","label":"Title size, desktop","min":14,"max":44,"step":1,"unit":"px","default":26},{"type":"range","id":"title_size_mobile","label":"Title size, phones","min":12,"max":32,"step":1,"unit":"px","default":18},{"type":"color","id":"button_bg","label":"Button color","info":"Empty = the page background color."},{"type":"color","id":"button_color","label":"Button text color","info":"Empty = the page text color."},{"type":"select","id":"button_shape","label":"Button corners","default":"square","options":[{"value":"square","label":"Square"},{"value":"rounded","label":"Rounded"}],"info":"Both are regular rectangles, never an oval."},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}]}
{% endschema %}
