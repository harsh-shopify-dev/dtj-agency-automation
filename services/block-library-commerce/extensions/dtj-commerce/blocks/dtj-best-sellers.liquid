{%- comment -%} GENERATED by tools/build_blocks.py from manifests/best-sellers.json and src/best-sellers.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ bs.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ bs.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ bs.side_padding | default: 16 }}px; --dtj-pad-right: {{ bs.side_padding | default: 16 }}px; {% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %}{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign bs_n = 0
  for c in bs.collections
    assign bs_n = bs_n | plus: 1
  endfor
  assign bs_head = bs.heading | strip
  assign bs_tag = 'h2'
  case bs.heading_tag
    when 'h1' or 'h3'
      assign bs_tag = bs.heading_tag
  endcase
  assign bs_add = bs.quick_add | default: 'bar'
  assign bs_ratio = bs.image_ratio | default: '1'
  assign bs_vis = bs.visible_desktop | default: 4 | plus: 0.0
  assign bs_vw = 100.0 | divided_by: bs_vis | round
  assign bs_wanted = bs.badge_tags | split: ','
  assign bs_t_add = bs.add_label | default: 'Quick add' | escape
  assign bs_t_sold = bs.sold_out_label | default: 'Sold out' | escape
  assign bs_t_opts = bs.options_label | default: 'Choose options' | escape
  assign bs_t_sale = bs.sale_label | default: 'Sale' | escape
-%}
{%- if bs_n > 0 -%}
  <dtj-best-sellers class="dtj-b dtj-bs dtj-bs--card-{{ bs.card_style | default: 'outline' }} dtj-bs--tabs-{{ bs.tab_style | default: 'boxed' }} dtj-bs--add-{{ bs_add }} dtj-bs--arrows-{{ bs.arrows | default: 'square' }} dtj-bs--head-{{ bs.heading_align | default: 'left' }} dtj-bs--hf-{{ bs.heading_font | default: 'theme' }} dtj-bs--tf-{{ bs.title_font | default: 'theme' }} dtj-bs--fit-{{ bs.image_fit | default: 'contain' }} dtj-bs--btn-{{ bs.button_shape | default: 'square' }}{% if bs.badge_caps %} dtj-bs--caps{% endif %}{% if bs_n < 2 %} dtj-bs--one{% endif %}" data-after="{{ bs.after_add | default: 'stay' }}" data-added="{{ bs.added_label | default: 'Added' | escape }}" data-cart-add="{{ routes.cart_add_url }}" data-cart="{{ routes.cart_url }}" data-sold="{{ bs_t_sold }}" style="{{ dtj_std_style | strip_newlines }} --bs-w: {{ bs.container_width }}px; --bs-n: {{ bs_vis }}; --bs-nm: {{ bs.visible_mobile }}; --bs-gap: {{ bs.gap }}px; --bs-ar: {{ bs_ratio }}; --bs-r: {{ bs.card_radius }}px; --bs-sw: {{ bs.swatch_size }}px; --bs-lines: {{ bs.title_lines }}; --bs-h-d: {{ bs.heading_size_desktop }}px; --bs-h-m: {{ bs.heading_size_mobile }}px;{% if bs.accent_color != blank %} --bs-accent: {{ bs.accent_color }};{% endif %}{% if bs.accent_text != blank %} --bs-at: {{ bs.accent_text }};{% endif %}{% if bs.card_bg != blank %} --bs-card: {{ bs.card_bg }};{% endif %}" {{ block.shopify_attributes }}>
    <div class="dtj-bs__wrap">
      {%- if bs_head != blank -%}<{{ bs_tag }} class="dtj-bs__heading">{{ bs_head | escape }}</{{ bs_tag }}>{%- endif -%}
      <div class="dtj-bs__bar">
        {%- if bs_n > 1 -%}
          <div class="dtj-bs__tabs" role="tablist" aria-label="{{ bs_head | default: 'Collections' | escape }}">
            {%- for c in bs.collections -%}
              {%- liquid
                assign tk = 'tab_' | append: forloop.index
                assign tab_label = bs[tk] | strip
                if tab_label == blank
                  assign tab_label = c.title
                endif
              -%}
              <button type="button" class="dtj-bs__tab" role="tab" id="{{ block.id }}-tab-{{ forloop.index }}" aria-controls="{{ block.id }}-panel-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}>{{ tab_label | escape }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if bs.arrows != 'none' -%}
          <div class="dtj-bs__arrows">
            <button type="button" class="dtj-bs__arrow dtj-bs__prev" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button type="button" class="dtj-bs__arrow dtj-bs__next" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg></button>
          </div>
        {%- endif -%}
      </div>
      {%- for c in bs.collections -%}
        {%- assign panel_i = forloop.index -%}
        <div class="dtj-bs__panel" id="{{ block.id }}-panel-{{ panel_i }}"{% if bs_n > 1 %} role="tabpanel" aria-labelledby="{{ block.id }}-tab-{{ panel_i }}"{% endif %}{% unless forloop.first %} hidden{% endunless %}>
          <ul class="dtj-bs__track" role="list" tabindex="0" aria-label="{{ c.title | escape }}">
            {%- for product in c.products limit: bs.products_per_tab -%}
              {%- liquid
                assign p_variant = product.selected_or_first_available_variant
                assign p_price = p_variant.price | default: 0 | plus: 0
                assign p_compare = p_variant.compare_at_price | default: 0 | plus: 0
                assign p_sale = false
                if p_compare > p_price
                  assign p_sale = true
                endif

                # the badge is one of the product's own tags: the first of the wanted tags that the product carries, shown with the tag's own words
                assign p_badge = ''
                for w in bs_wanted
                  assign wl = w | strip | downcase
                  if wl != blank and p_badge == ''
                    for t in product.tags
                      assign tl = t | downcase
                      if tl == wl and p_badge == ''
                        assign p_badge = t
                      endif
                    endfor
                  endif
                endfor

                # the rating is read from Judge.me (its product badge markup), then from the standard review ratings; sample ratings only in the theme editor
                assign r_avg = 0
                assign r_cnt = 0
                assign r_src = ''
                if bs.show_rating
                  assign jm = product.metafields.judgeme.badge
                  if jm != blank
                    assign jm_a = jm | split: "data-average-rating='"
                    if jm_a.size < 2
                      assign jm_a = jm | split: 'data-average-rating="'
                    endif
                    if jm_a.size > 1
                      assign r_avg = jm_a[1] | split: "'" | first | split: '"' | first | plus: 0.0
                      assign jm_c = jm | split: "data-number-of-reviews='"
                      if jm_c.size < 2
                        assign jm_c = jm | split: 'data-number-of-reviews="'
                      endif
                      if jm_c.size > 1
                        assign r_cnt = jm_c[1] | split: "'" | first | split: '"' | first | plus: 0
                      endif
                      assign r_src = 'judgeme'
                    endif
                  endif
                  if r_src == ''
                    assign std = product.metafields.reviews.rating.value
                    if std != blank
                      assign r_avg = std.rating | default: 0 | plus: 0.0
                      assign r_cnt = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
                      assign r_src = 'standard'
                    endif
                  endif
                  if r_cnt < 1 or r_avg < 0.1
                    assign r_src = ''
                  endif
                  if r_src == '' and bs.demo_ratings and request.design_mode
                    assign seed = product.id | default: 0 | plus: 0
                    assign r_avg = seed | modulo: 10 | times: 0.1 | plus: 4.0
                    assign r_cnt = seed | modulo: 57 | plus: 3
                    assign r_src = 'demo'
                  endif
                endif

                assign p_pic = product.featured_image
                assign p_multi = false
                if product.options.size > 1
                  assign p_multi = true
                endif
                assign p_link_only = false
                if product.has_only_default_variant == false and p_multi and bs.multi_option != 'first'
                  assign p_link_only = true
                endif
                assign p_has_variants = false
                if product.has_only_default_variant == false and bs.swatches
                  assign p_has_variants = true
                endif
              -%}
              <li class="dtj-bs__card" data-handle="{{ product.handle }}">
                <div class="dtj-bs__media">
                  {%- if bs.gallery and product.images.size > 1 -%}
                    <div class="dtj-bs__gallery">
                      {%- for img in product.images limit: 4 -%}
                        <a class="dtj-bs__slide" href="{{ product.url }}" tabindex="-1" aria-hidden="true"><img class="dtj-bs__img{% if forloop.first %} dtj-bs__img--main{% endif %}" src="{{ img | image_url: width: 600 }}" srcset="{{ img | image_url: width: 300 }} 300w, {{ img | image_url: width: 450 }} 450w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 800 }} 800w" sizes="(min-width: 750px) {{ bs_vw }}vw, 60vw" width="{{ img.width | default: 600 }}" height="{{ img.height | default: 600 }}" alt="" loading="lazy" decoding="async"></a>
                      {%- endfor -%}
                    </div>
                    <div class="dtj-bs__dots" aria-hidden="true">{%- for img in product.images limit: 4 -%}<i class="dtj-bs__dot{% if forloop.first %} is-on{% endif %}"></i>{%- endfor -%}</div>
                  {%- elsif p_pic != nil -%}
                    <a class="dtj-bs__imglink" href="{{ product.url }}" tabindex="-1" aria-hidden="true"><img class="dtj-bs__img dtj-bs__img--main" src="{{ p_pic | image_url: width: 600 }}" srcset="{{ p_pic | image_url: width: 300 }} 300w, {{ p_pic | image_url: width: 450 }} 450w, {{ p_pic | image_url: width: 600 }} 600w, {{ p_pic | image_url: width: 800 }} 800w" sizes="(min-width: 750px) {{ bs_vw }}vw, 60vw" width="{{ p_pic.width | default: 600 }}" height="{{ p_pic.height | default: 600 }}" alt="" loading="lazy" decoding="async"></a>
                  {%- endif -%}
                  {%- if p_badge != '' -%}
                    <span class="dtj-bs__badge">{{ p_badge | escape }}</span>
                  {%- elsif p_sale and bs.sale_badge -%}
                    <span class="dtj-bs__badge dtj-bs__badge--sale">{{ bs_t_sale }}</span>
                  {%- endif -%}
                  {%- if bs.wishlist -%}
                    <button type="button" class="dtj-bs__heart" data-handle="{{ product.handle }}" aria-pressed="false" aria-label="{{ product.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5l-1.2-1.1C6 15.1 3 12.3 3 8.9A4.4 4.4 0 0 1 7.5 4.5c1.7 0 3.4.8 4.5 2.1 1.1-1.3 2.8-2.1 4.5-2.1A4.4 4.4 0 0 1 21 8.9c0 3.4-3 6.2-7.8 10.5L12 20.5z"/></svg></button>
                  {%- endif -%}
                </div>
                <div class="dtj-bs__body">
                  <a class="dtj-bs__title" href="{{ product.url }}">{{ product.title | escape }}</a>
                  {%- if p_has_variants -%}
                    {%- assign sw_seen = '|' -%}
                    {%- assign sw_n = 0 -%}
                    <div class="dtj-bs__swatches" role="radiogroup" aria-label="{{ product.options | first | escape }}">
                      {%- for v in product.variants -%}
                        {%- assign sw_key = v.option1 | prepend: '|' | append: '|' -%}
                        {%- unless sw_seen contains sw_key or sw_n > 5 -%}
                          {%- assign sw_seen = sw_seen | append: v.option1 | append: '|' -%}
                          {%- assign sw_n = sw_n | plus: 1 -%}
                          {%- assign sw_on = false -%}
                          {%- if v.option1 == p_variant.option1 -%}{%- assign sw_on = true -%}{%- endif -%}
                          <button type="button" class="dtj-bs__sw{% if sw_on %} is-on{% endif %}{% if v.featured_image == nil %} dtj-bs__sw--text{% endif %}" role="radio" aria-checked="{% if sw_on %}true{% else %}false{% endif %}" aria-label="{{ v.option1 | escape }}" data-id="{{ v.id }}" data-price="{{ v.price | money }}" data-compare="{% if v.compare_at_price > v.price and bs.show_compare_price %}{{ v.compare_at_price | money }}{% endif %}" data-available="{{ v.available }}"{% if v.featured_image != nil %} data-img="{{ v.featured_image | image_url: width: 600 }}" data-srcset="{{ v.featured_image | image_url: width: 300 }} 300w, {{ v.featured_image | image_url: width: 450 }} 450w, {{ v.featured_image | image_url: width: 600 }} 600w, {{ v.featured_image | image_url: width: 800 }} 800w"{% endif %}>{%- if v.featured_image != nil -%}<img src="{{ v.featured_image | image_url: width: 80 }}" width="40" height="40" alt="" loading="lazy" decoding="async">{%- else -%}<span>{{ v.option1 | escape }}</span>{%- endif -%}</button>
                        {%- endunless -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- capture rating_html -%}
                    {%- if r_src != '' -%}<span class="dtj-bs__rating{% if r_src == 'demo' %} dtj-bs__rating--demo{% endif %}" data-source="{{ r_src }}"{% if r_src == 'demo' %} title="Sample rating, shown only in the theme editor"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.5l-5.9 3.2 1.2-6.6-4.8-4.6 6.6-.9L12 2.5z"/></svg><span>{{ r_avg | round: 1 }}</span><span class="dtj-bs__count">({{ r_cnt }})</span></span>{%- endif -%}
                  {%- endcapture -%}
                  {%- capture price_html -%}{%- if p_sale and bs.show_compare_price -%}<s class="dtj-bs__old">{{ p_compare | money }}</s> {% endif -%}<span class="dtj-bs__now">{{ p_price | money }}</span>{%- endcapture -%}
                  {%- if bs_add == 'bar' -%}
                    {%- if r_src != '' -%}<div class="dtj-bs__row">{{ rating_html }}</div>{%- endif -%}
                  {%- else -%}
                    <div class="dtj-bs__row"><p class="dtj-bs__price">{{ price_html }}</p>{{ rating_html }}</div>
                  {%- endif -%}
                  {%- if bs_add != 'none' -%}
                    {%- if product.available == false -%}
                      <span class="dtj-bs__add dtj-bs__add--off" aria-disabled="true"><span class="dtj-bs__add-label">{{ bs_t_sold }}</span>{%- if bs_add == 'bar' -%}<span class="dtj-bs__amount">{{ price_html }}</span>{%- endif -%}</span>
                    {%- elsif product.has_only_default_variant == false and p_link_only -%}
                      <a class="dtj-bs__add dtj-bs__add--page" href="{{ product.url }}"><span class="dtj-bs__add-label">{{ bs_t_opts }}</span>{%- if bs_add == 'bar' -%}<span class="dtj-bs__amount">{{ price_html }}</span>{%- endif -%}</a>
                    {%- else -%}
                      <form class="dtj-bs__form" action="{{ routes.cart_add_url }}" method="post"><input type="hidden" name="id" value="{{ p_variant.id }}"><input type="hidden" name="quantity" value="1"><button type="submit" class="dtj-bs__add"><span class="dtj-bs__add-label">{{ bs_t_add }}</span>{%- if bs_add == 'bar' -%}<span class="dtj-bs__amount">{{ price_html }}</span>{%- endif -%}</button></form>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
      <p class="dtj-bs__status" role="status" aria-live="polite"></p>
    </div>
  </dtj-best-sellers>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Best Sellers is empty. Pick one or more collections (editor only: shoppers see nothing).</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

{% schema %}
{"name":"DTJ Best Sellers","target":"section","stylesheet":"dtj-best-sellers.css","settings":[{"type":"header","content":"Words"},{"type":"text","id":"heading","label":"Heading","info":"Empty = hidden."},{"type":"select","id":"heading_align","label":"Heading alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Centred"}]},{"type":"select","id":"heading_tag","label":"Heading tag","default":"h2","options":[{"value":"h2","label":"h2"},{"value":"h1","label":"h1"},{"value":"h3","label":"h3"}]},{"type":"header","content":"Tabs and products"},{"type":"collection_list","id":"collections","label":"Collections (one tab each)","limit":5,"info":"Each collection becomes a tab and shows its own products. One collection = no tabs, just the row."},{"type":"text","id":"tab_1","label":"Tab 1: name","info":"Empty = the collection name."},{"type":"text","id":"tab_2","label":"Tab 2: name"},{"type":"text","id":"tab_3","label":"Tab 3: name"},{"type":"text","id":"tab_4","label":"Tab 4: name"},{"type":"text","id":"tab_5","label":"Tab 5: name"},{"type":"range","id":"products_per_tab","label":"Products per tab","min":2,"max":12,"step":1,"default":8},{"type":"text","id":"badge_tags","label":"Badge tags","info":"Product tags to show as a badge, most important first, separated by commas, e.g. bestseller, trending, new. A product shows the first one it carries, with the tag's own words. Empty = no tag badges."},{"type":"checkbox","id":"sale_badge","label":"Sale badge on reduced products without a badge tag","default":true},{"type":"checkbox","id":"show_compare_price","label":"Show the old price when a product is on sale","default":true},{"type":"checkbox","id":"swatches","label":"Show variants under the name","default":true,"info":"Picture swatches (or words) for the first option. Pressing one changes the picture, price and cart variant in the card. A product without variants shows nothing."},{"type":"select","id":"multi_option","label":"A product with more than one option","default":"page","options":[{"value":"page","label":"The button opens the product page"},{"value":"first","label":"Add the first available option of the swatch"}],"info":"Size and color together cannot be chosen in a small card."},{"type":"checkbox","id":"show_rating","label":"Show the star rating","default":true,"info":"Read from Judge.me (its product badge, or the standard review ratings). A product with no reviews shows no rating."},{"type":"checkbox","id":"demo_ratings","label":"Show sample ratings in the theme editor only","default":true,"info":"Lets you see the finished card before reviews exist. Shoppers NEVER see sample ratings: on the store a product without reviews shows no rating."},{"type":"checkbox","id":"wishlist","label":"Heart button on the picture","default":false,"info":"Saves favourites in the visitor's own browser only (no account, no sync)."},{"type":"checkbox","id":"gallery","label":"Swipe through up to 4 pictures in the card","default":false,"info":"Dots show which picture is in view."},{"type":"header","content":"Layout"},{"type":"select","id":"card_style","label":"Card style","default":"outline","options":[{"value":"outline","label":"Outlined card"},{"value":"soft","label":"Soft card with a shadow"},{"value":"tinted","label":"Tinted card"},{"value":"plain","label":"No box"}]},{"type":"select","id":"quick_add","label":"Cart button","default":"bar","options":[{"value":"bar","label":"Bar with the price"},{"value":"button","label":"Full-width button, price above"},{"value":"none","label":"No button, price only"}],"info":"A one-variant product is added in place; a product with options follows the setting above."},{"type":"select","id":"button_shape","label":"Button corners","default":"square","options":[{"value":"square","label":"Square"},{"value":"rounded","label":"Rounded"}],"info":"Both are regular rectangles, never an oval."},{"type":"select","id":"tab_style","label":"Tab style","default":"boxed","options":[{"value":"boxed","label":"Boxes with a dashed outline"},{"value":"pill","label":"Pills"},{"value":"underline","label":"Underline"}]},{"type":"range","id":"visible_desktop","label":"Products in view on desktop","min":2,"max":6,"step":0.5,"default":4,"info":"A half card at the edge shows there is more to swipe."},{"type":"range","id":"visible_mobile","label":"Products in view on phones","min":1.5,"max":3,"step":0.5,"default":1.5},{"type":"range","id":"gap","label":"Space between cards","min":6,"max":32,"step":2,"default":16,"unit":"px"},{"type":"select","id":"image_ratio","label":"Picture shape","default":"1","options":[{"value":"1","label":"Square"},{"value":"0.8","label":"Portrait 4:5"},{"value":"0.75","label":"Portrait 3:4"},{"value":"1.25","label":"Landscape 5:4"}]},{"type":"select","id":"image_fit","label":"Picture fit","default":"contain","options":[{"value":"contain","label":"Show the whole product"},{"value":"cover","label":"Fill the box (crops)"}]},{"type":"range","id":"swatch_size","label":"Swatch size","min":20,"max":44,"step":2,"default":30,"unit":"px"},{"type":"range","id":"title_lines","label":"Product name lines","min":1,"max":3,"step":1,"default":2},{"type":"range","id":"container_width","label":"Maximum width","min":600,"max":1920,"step":20,"default":1400,"unit":"px"},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":24,"step":2,"default":0,"unit":"px"},{"type":"header","content":"Look"},{"type":"select","id":"heading_font","label":"Heading font","default":"theme","options":[{"value":"theme","label":"Theme heading font"},{"value":"serif","label":"Serif"},{"value":"sans","label":"Clean sans"}]},{"type":"range","id":"heading_size_desktop","label":"Heading size, desktop","min":20,"max":72,"step":1,"default":44,"unit":"px"},{"type":"range","id":"heading_size_mobile","label":"Heading size, phones","min":18,"max":44,"step":1,"default":28,"unit":"px"},{"type":"select","id":"title_font","label":"Product name font","default":"theme","options":[{"value":"theme","label":"Theme font"},{"value":"serif","label":"Serif"}]},{"type":"color","id":"accent_color","label":"Accent color","info":"The active tab, the cart button, the badge and the rating. Empty = the text color."},{"type":"color","id":"accent_text","label":"Text on the accent color","info":"Empty = the background color."},{"type":"color","id":"card_bg","label":"Card color","info":"For the Tinted style. Empty = a soft tint of the text color."},{"type":"checkbox","id":"badge_caps","label":"Badge words in capitals","default":true},{"type":"select","id":"arrows","label":"Arrows","default":"square","options":[{"value":"square","label":"Squares"},{"value":"circle","label":"Circles"},{"value":"none","label":"No arrows (swipe only)"}]},{"type":"select","id":"after_add","label":"After adding to the cart","default":"stay","options":[{"value":"stay","label":"Stay here and confirm on the button"},{"value":"cart","label":"Go to the cart page"}]},{"type":"text","id":"add_label","label":"Cart button words","info":"Empty = Quick add."},{"type":"text","id":"added_label","label":"Words after adding","info":"Empty = Added."},{"type":"text","id":"options_label","label":"Words for a product with options","info":"Empty = Choose options."},{"type":"text","id":"sold_out_label","label":"Words for a sold-out product","info":"Empty = Sold out."},{"type":"text","id":"sale_label","label":"Words on the sale badge","info":"Empty = Sale."},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":32},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}],"javascript":"dtj-best-sellers.js"}
