"text","id":"name_7","label":"Logo 7: name"},{"type":"url","id":"link_7","label":"Logo 7: link"},{"type":"image_picker","id":"logo_8","label":"Logo 8"},{"type":"text","id":"name_8","label":"Logo 8: name"},{"type":"url","id":"link_8","label":"Logo 8: link"},{"type":"header","content":"Layout and look"},{"type":"select","id":"layout","label":"Layout","default":"row","options":[{"value":"row","label":"Row: centred, wraps on phones"},{"value":"grid","label":"Even grid"},{"value":"marquee","label":"Scrolling band"}],"info":"The band moves by itself, stops on hover and stands still for visitors who prefer less motion."},{"type":"range","id":"logo_height","label":"Logo height","min":16,"max":80,"step":2,"default":36,"unit":"px"},{"type":"range","id":"gap","label":"Space between logos","min":8,"max":80,"step":2,"default":40,"unit":"px"},{"type":"range","id":"columns","label":"Columns in the grid on desktop","min":2,"max":6,"step":1,"default":4},{"type":"select","id":"logo_tone","label":"Logo color","default":"gray","options":[{"value":"original","label":"Original colors"},{"value":"gray","label":"Soft gray"},{"value":"dark","label":"All dark"},{"value":"light","label":"All white"}],"info":"Dark and white turn any logo into a one-color mark, so a mixed set looks even."},{"type":"range","id":"logo_opacity","label":"Logo strength","min":30,"max":100,"step":5,"default":75,"unit":"%"},{"type":"checkbox","id":"color_on_hover","label":"Show original colors on hover","default":true},{"type":"range","id":"speed","label":"Scrolling band: seconds for one pass","min":10,"max":80,"step":5,"default":30,"unit":"s"},{"type":"checkbox","id":"bordered","label":"Thin lines above and below","default":false},{"type":"range","id":"container_width","label":"Maximum width","min":600,"max":1920,"step":20,"default":1200,"unit":"px"},{"type":"range","id":"heading_size","label":"Heading size","min":11,"max":32,"step":1,"default":14,"unit":"px"},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":24},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":24},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}]}
