{%- comment -%} Icons for the DTJ Marquee Band. Called as: render 'dtj-mq-icon', name: 'truck'. A name that starts with "e-" is an emoji (written as text so it keeps its own colors); any other known name is a stroke icon on a 24 grid that takes the current text color. An unknown name draws nothing. {%- endcomment -%}
{%- case name -%}
{%- when 'e-bolt' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#9889;</span>
{%- when 'e-fire' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#128293;</span>
{%- when 'e-gift' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#127873;</span>
{%- when 'e-star' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#11088;</span>
{%- when 'e-heart' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#10084;&#65039;</span>
{%- when 'e-truck' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#128666;</span>
{%- when 'e-sparkle' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#10024;</span>
{%- when 'e-party' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#127881;</span>
{%- when 'e-check' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#9989;</span>
{%- when 'e-tag' -%}<span class="dtj-mq__emoji" aria-hidden="true">&#127991;&#65039;</span>
{%- else -%}{%- capture mq_paths -%}{%- case name -%}
{%- when 'return' -%}<path d="M9 6L4 11l5 5"/><path d="M4 11h11a5 5 0 0 1 0 10h-3"/>
{%- when 'support' -%}<circle cx="9" cy="7" r="3.2"/><path d="M3 20c0-3.6 2.7-6 6-6s6 2.4 6 6"/><circle cx="17" cy="9" r="2.6"/><path d="M16 14.3c3 .2 5 2.3 5 5.7"/>
{%- when 'truck' -%}<path d="M2 6h11v10H2zM13 9h4l4 3v4h-8"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
{%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
{%- when 'star' -%}<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/>
{%- when 'bolt' -%}<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>
{%- when 'fire' -%}<path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.2 2-4.2 0 1.7 1 2.7 2 2.7 0-3-1-5 1-8.5z"/>
{%- when 'gift' -%}<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M12 9v12M3 13h18M12 9C9 9 7.500 7.500 7.500 6a2 2 0 0 1 4.500 0M12 9c3 0 4.500-1.500 4.500-3a2 2 0 0 0-4.500 0"/>
{%- when 'tag' -%}<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.500" cy="8.500" r="1.200"/>
{%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- when 'check' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.500l3 3 5-6"/>
{%- when 'box' -%}<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.300 7.500L12 12l8.700-4.500M12 12v9"/>
{%- endcase -%}{%- endcapture -%}{%- if mq_paths != blank -%}<svg class="dtj-mq__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ mq_paths }}</svg>{%- endif -%}
{%- endcase -%}
