{
  "id": "before-after",
  "title": "DTJ Before After",
  "block_file": "extensions/dtj-shop/blocks/dtj-before-after.liquid",
  "placements": [
    "home",
    "product"
  ],
  "licence": true,
  "min_filled_slots": 1,
  "css_includes": [],
  "script": true,
  "slots": [
    {
      "id": "heading",
      "type": "text",
      "required": false,
      "max_length": 100
    },
    {
      "id": "heading_accent",
      "type": "text",
      "required": false,
      "max_length": 100
    },
    {
      "id": "button_label",
      "type": "text",
      "required": false,
      "max_length": 40
    }
  ],
  "standard_controls": [
    "spacing_v",
    "gutter",
    "colors"
  ],
  "standard_defaults": {
    "padding_top": 48,
    "padding_bottom": 48,
    "side_padding": 16
  },
  "settings": [
    {
      "type": "header",
      "content": "Pictures"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before picture"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After picture",
      "info": "Use the same size and framing as the before picture so the two line up."
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before tag words",
      "info": "Shows Before when empty."
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After tag words",
      "info": "Shows After when empty."
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show the Before / After tags",
      "default": true
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Where the divider starts",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Words"
    },
    {
      "type": "text",
      "id": "eyebrow_bold",
      "label": "Small line: bold words"
    },
    {
      "type": "text",
      "id": "eyebrow_rest",
      "label": "Small line: the rest"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Five stars in the small line",
      "default": false,
      "info": "Only switch on if the store really has five-star reviews to back it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading: the part in the accent color"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "h1"
        },
        {
          "value": "h2",
          "label": "h2"
        },
        {
          "value": "h3",
          "label": "h3"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Paragraph",
      "info": "Bold works here."
    },
    {
      "type": "text",
      "id": "point_1_bold",
      "label": "Point 1: bold words"
    },
    {
      "type": "text",
      "id": "point_1_rest",
      "label": "Point 1: the rest"
    },
    {
      "type": "select",
      "id": "point_1_icon",
      "label": "Point 1: icon",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (the version's own)"
        },
        {
          "value": "tick",
          "label": "Tick"
        },
        {
          "value": "badge",
          "label": "Badge with tick"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "smile",
          "label": "Smile"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "bolt",
          "label": "Bolt"
        },
        {
          "value": "shield",
          "label": "Shield"
        }
      ]
    },
    {
      "type": "text",
      "id": "point_2_bold",
      "label": "Point 2: bold words"
    },
    {
      "type": "text",
      "id": "point_2_rest",
      "label": "Point 2: the rest"
    },
    {
      "type": "select",
      "id": "point_2_icon",
      "label": "Point 2: icon",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (the version's own)"
        },
        {
          "value": "tick",
          "label": "Tick"
        },
        {
          "value": "badge",
          "label": "Badge with tick"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "smile",
          "label": "Smile"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "bolt",
          "label": "Bolt"
        },
        {
          "value": "shield",
          "label": "Shield"
        }
      ]
    },
    {
      "type": "text",
      "id": "point_3_bold",
      "label": "Point 3: bold words"
    },
    {
      "type": "text",
      "id": "point_3_rest",
      "label": "Point 3: the rest"
    },
    {
      "type": "select",
      "id": "point_3_icon",
      "label": "Point 3: icon",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (the version's own)"
        },
        {
          "value": "tick",
          "label": "Tick"
        },
        {
          "value": "badge",
          "label": "Badge with tick"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "smile",
          "label": "Smile"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "bolt",
          "label": "Bolt"
        },
        {
          "value": "shield",
          "label": "Shield"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button words"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_arrow",
      "label": "Arrow in the button",
      "default": true
    },
    {
      "type": "header",
      "content": "Version and layout"
    },
    {
      "type": "select",
      "id": "variation",
      "label": "Version",
      "default": "card",
      "options": [
        {
          "value": "card",
          "label": "Rounded picture in a soft card"
        },
        {
          "value": "circle",
          "label": "Round picture, tags at the sides"
        },
        {
          "value": "square",
          "label": "Square picture, tags at the bottom"
        }
      ],
      "info": "Each version sets its own picture shape, side, tags, icons and button. The settings below can change them."
    },
    {
      "type": "select",
      "id": "picture_side",
      "label": "Picture side on desktop",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "The version's own"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "picture_shape",
      "label": "Picture shape",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "The version's own"
        },
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "1.333",
          "label": "Landscape 4:3"
        },
        {
          "value": "0.8",
          "label": "Portrait 4:5"
        },
        {
          "value": "1.778",
          "label": "Wide 16:9"
        }
      ]
    },
    {
      "type": "select",
      "id": "tag_place",
      "label": "Tag place",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "The version's own"
        },
        {
          "value": "top",
          "label": "Top corners"
        },
        {
          "value": "middle",
          "label": "Middle sides"
        },
        {
          "value": "bottom",
          "label": "Bottom corners"
        }
      ]
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size on desktop",
      "min": 24,
      "max": 72,
      "step": 1,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size on phones",
      "min": 20,
      "max": 48,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Heading accent, icons, tags. Empty = the version's own."
    },
    {
      "type": "color",
      "id": "accent_color_2",
      "label": "Second accent color",
      "info": "Optional: makes the accent words a gradient from the accent color to this one."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "info": "Empty = the version's own."
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "info": "Empty = the version's own."
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Section tint",
      "info": "Empty = the version's own soft tint. Set the background color above to override it fully."
    }
  ],
  "data_needs": [],
  "reference_image": "Three before/after sections (Harsh, 13 Oct 2026): a rounded picture beside text inside a soft green card with Before/After tags at the top corners; a round picture with tags at the sides, a gradient heading line and a dark button on pink; a square picture on the right with tags at the bottom on a soft ecru gradient",
  "test": {
    "sample": {
      "variation": "card",
      "before_image": {
        "src": "before-pic",
        "width": 800,
        "height": 600,
        "alt": "Before picture alt"
      },
      "after_image": {
        "src": "after-pic",
        "width": 800,
        "height": 600
      },
      "heading": "From mess to",
      "heading_accent": "effortlessly clean",
      "body": "<p>A <strong>concentrated</strong> formula.</p>",
      "point_1_bold": "Helps cut through",
      "point_1_rest": "grease",
      "point_2_bold": "Fresh finish",
      "point_2_rest": "without residue",
      "button_label": "Shop home care",
      "button_link": "/collections/all"
    },
    "expect": [
      "From mess to",
      "effortlessly clean",
      "Helps cut through",
      "Shop home care",
      "dtj-ba__range",
      "before-pic",
      "after-pic"
    ]
  }
}
