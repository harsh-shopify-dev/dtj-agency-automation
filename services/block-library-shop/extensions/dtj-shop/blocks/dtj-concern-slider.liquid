{%- comment -%} GENERATED by tools/build_blocks.py from manifests/concern-slider.json and src/concern-slider.liquid. Do not edit this file. {%- endcomment -%}
{%- assign bs = block.settings -%}
{%- capture dtj_std_style -%}--dtj-pad-top: {{ bs.padding_top | default: 0 }}px; --dtj-pad-bottom: {{ bs.padding_bottom | default: 0 }}px; --dtj-pad-left: {{ bs.side_padding | default: 16 }}px; --dtj-pad-right: {{ bs.side_padding | default: 16 }}px; {% if bs.text_color != blank %}--dtj-text-color: {{ bs.text_color }};{% endif %} {% if bs.background != blank %}--dtj-background: {{ bs.background }};{% endif %}{%- endcapture -%}
{%- capture dtj_content -%}
{%- liquid
  assign cs_n = 0
  for c in bs.collections
    assign cs_n = cs_n | plus: 1
  endfor
  assign cs_head = bs.heading | strip
  assign cs_accent = bs.heading_accent | strip
  assign cs_sub = bs.subtext | strip
  assign cs_tag = 'h2'
  case bs.heading_tag
    when 'h1' or 'h3'
      assign cs_tag = bs.heading_tag
  endcase
  assign cs_vis = bs.visible_desktop | default: 3.5 | plus: 0.0
  assign cs_vw = 100.0 | divided_by: cs_vis | round
  assign cs_t_add = bs.add_label | default: 'Add to Cart' | escape
  assign cs_t_added = bs.added_label | default: 'Added' | escape
  assign cs_t_sold = bs.sold_out_label | default: 'Sold out' | escape
  assign cs_t_view = bs.view_label | default: 'View Collection' | escape
  assign cs_t_off = bs.off_label | default: 'OFF' | escape
  assign cs_t_rev = bs.reviews_label | default: 'reviews' | escape
-%}
{%- if cs_n > 0 -%}
  <dtj-concern-slider class="dtj-b dtj-cs dtj-cs--btn-{{ bs.button_shape | default: 'pill' }} dtj-cs--hf-{{ bs.heading_font | default: 'serif' }} dtj-cs--fit-{{ bs.image_fit | default: 'cover' }} dtj-cs--arrows-{{ bs.arrows | default: 'round' }}{% if bs.fade_edge %} dtj-cs--fade{% endif %}{% if cs_n < 2 %} dtj-cs--one{% endif %}" data-after="{{ bs.after_add | default: 'stay' }}" data-added="{{ cs_t_added }}" data-sold="{{ cs_t_sold }}" data-cart-add="{{ routes.cart_add_url }}" data-cart="{{ routes.cart_url }}" style="{{ dtj_std_style | strip_newlines }} --cs-w: {{ bs.container_width }}px; --cs-n: {{ cs_vis }}; --cs-nm: {{ bs.visible_mobile }}; --cs-gap: {{ bs.gap }}px; --cs-r: {{ bs.card_radius }}px; --cs-ar: {{ bs.image_ratio | default: '1' }}; --cs-col: {{ bs.text_column }}%; --cs-h-d: {{ bs.heading_size_desktop }}px; --cs-h-m: {{ bs.heading_size_mobile }}px;{% if bs.accent_color != blank %} --cs-accent: {{ bs.accent_color }};{% endif %}{% if bs.card_bg != blank %} --cs-card: {{ bs.card_bg }};{% endif %}{% if bs.button_color != blank %} --cs-btn: {{ bs.button_color }};{% endif %}{% if bs.button_text != blank %} --cs-btn-text: {{ bs.button_text }};{% endif %}{% if bs.pill_color != blank %} --cs-pill: {{ bs.pill_color }};{% endif %}{% if bs.pill_text != blank %} --cs-pill-text: {{ bs.pill_text }};{% endif %}" {{ block.shopify_attributes }}>
    <div class="dtj-cs__wrap">
      <div class="dtj-cs__side">
        {%- if cs_head != blank or cs_accent != blank -%}
          <{{ cs_tag }} class="dtj-cs__heading">{% if cs_head != blank %}<span class="dtj-cs__line">{{ cs_head | escape }}</span>{% endif %}{% if cs_accent != blank %} <span class="dtj-cs__line dtj-cs__accent">{{ cs_accent | escape }}</span>{% endif %}</{{ cs_tag }}>
        {%- endif -%}
        {%- if cs_sub != blank -%}<p class="dtj-cs__sub">{{ cs_sub | escape }}</p>{%- endif -%}
        {%- if cs_n > 1 -%}
          <div class="dtj-cs__pick">
            <select class="dtj-cs__concern" aria-label="{{ cs_head | append: ' ' | append: cs_accent | strip | default: 'Concern' | escape }}">
              {%- for c in bs.collections -%}
                {%- liquid
                  assign ck = 'concern_' | append: forloop.index
                  assign cl = bs[ck] | strip
                  if cl == blank
                    assign cl = c.title
                  endif
                -%}
                <option value="{{ forloop.index0 }}"{% if forloop.first %} selected{% endif %}>{{ cl | escape }}</option>
              {%- endfor -%}
            </select>
            <svg class="dtj-cs__chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        {%- endif -%}
      </div>
      <div class="dtj-cs__main">
        {%- for c in bs.collections -%}
          {%- assign total = c.products.size | at_most: bs.products_per_concern -%}
          <div class="dtj-cs__panel" data-total="{{ total }}"{% unless forloop.first %} hidden{% endunless %}>
            <div class="dtj-cs__viewport">
              <ul class="dtj-cs__track" role="list" tabindex="0" aria-label="{{ c.title | escape }}">
                {%- for product in c.products limit: bs.products_per_concern -%}
                  {%- liquid
                    assign p_variant = product.selected_or_first_available_variant
                    assign p_price = p_variant.price | default: 0 | plus: 0
                    assign p_compare = p_variant.compare_at_price | default: 0 | plus: 0
                    assign p_sale = false
                    if p_compare > p_price
                      assign p_sale = true
                    endif
                    assign p_off = ''
                    if p_sale
                      assign p_pct = p_compare | minus: p_price | times: 100 | divided_by: p_compare
                      if p_pct > 0
                        assign p_off = p_pct | append: '% ' | append: cs_t_off
                      endif
                    endif

                    # the rating is read from Judge.me (its product badge markup), then from the standard review ratings; sample ratings only in the theme editor
                    assign r_avg = 0
                    assign r_cnt = 0
                    assign r_src = ''
                    if bs.show_rating
                      assign jm = product.metafields.judgeme.badge
                      if jm != blank
                        assign jm_a = jm | split: "data-average-rating='"
                        if jm_a.size < 2
                          assign jm_a = jm | split: 'data-average-rating="'
                        endif
                        if jm_a.size > 1
                          assign r_avg = jm_a[1] | split: "'" | first | split: '"' | first | plus: 0.0
                          assign jm_c = jm | split: "data-number-of-reviews='"
                          if jm_c.size < 2
                            assign jm_c = jm | split: 'data-number-of-reviews="'
                          endif
                          if jm_c.size > 1
                            assign r_cnt = jm_c[1] | split: "'" | first | split: '"' | first | plus: 0
                          endif
                          assign r_src = 'judgeme'
                        endif
                      endif
                      if r_src == ''
                        assign std = product.metafields.reviews.rating.value
                        if std != blank
                          assign r_avg = std.rating | default: 0 | plus: 0.0
                          assign r_cnt = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
                          assign r_src = 'standard'
                        endif
                      endif
                      if r_cnt < 1 or r_avg < 0.1
                        assign r_src = ''
                      endif
                      if r_src == '' and bs.demo_ratings and request.design_mode
                        assign seed = product.id | default: 0 | plus: 0
                        assign r_avg = seed | modulo: 10 | times: 0.1 | plus: 4.0
                        assign r_cnt = seed | modulo: 57 | plus: 3
                        assign r_src = 'demo'
                      endif
                    endif

                    assign p_blurb = ''
                    if bs.show_blurb
                      assign p_blurb = product.metafields.custom.subtitle | strip_html | strip
                      if p_blurb == blank
                        assign p_blurb = product.description | strip_html | strip_newlines | strip | truncate: bs.blurb_length
                      endif
                    endif
                    assign p_pic = product.featured_image
                    assign p_pick = false
                    if bs.show_variants and product.has_only_default_variant == false
                      assign p_pick = true
                    endif
                  -%}
                  <li class="dtj-cs__card" data-handle="{{ product.handle }}">
                    <a class="dtj-cs__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                      {%- if p_pic != nil -%}<img class="dtj-cs__img" src="{{ p_pic | image_url: width: 600 }}" srcset="{{ p_pic | image_url: width: 300 }} 300w, {{ p_pic | image_url: width: 450 }} 450w, {{ p_pic | image_url: width: 600 }} 600w, {{ p_pic | image_url: width: 800 }} 800w" sizes="(min-width: 750px) {{ cs_vw }}vw, 60vw" width="{{ p_pic.width | default: 600 }}" height="{{ p_pic.height | default: 600 }}" alt="" loading="{% if forloop.parentloop.first and forloop.index <= 4 %}eager{% else %}lazy{% endif %}" decoding="async">{%- endif -%}
                    </a>
                    <div class="dtj-cs__body">
                      {%- if r_src != '' -%}
                        <p class="dtj-cs__rating{% if r_src == 'demo' %} dtj-cs__rating--demo{% endif %}" data-source="{{ r_src }}"{% if r_src == 'demo' %} title="Sample rating, shown only in the theme editor"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 17.5l-5.9 3.2 1.2-6.6-4.8-4.6 6.6-.9L12 2.5z"/></svg><strong>{{ r_avg | round: 2 }}</strong> <span>({{ r_cnt }} {{ cs_t_rev }})</span></p>
                      {%- endif -%}
                      <a class="dtj-cs__title" href="{{ product.url }}">{{ product.title | escape }}</a>
                      {%- if p_blurb != blank -%}<p class="dtj-cs__blurb">{{ p_blurb | escape }}</p>{%- endif -%}
                      <p class="dtj-cs__price">
                        <span class="dtj-cs__now">{{ p_price | money }}</span>
                        {%- if bs.show_compare_price -%}<s class="dtj-cs__old"{% unless p_sale %} hidden{% endunless %}>{% if p_sale %}{{ p_compare | money }}{% endif %}</s>{%- endif -%}
                        {%- if bs.show_discount -%}<span class="dtj-cs__off"{% if p_off == '' %} hidden{% endif %}>{{ p_off }}</span>{%- endif -%}
                      </p>
                      <form class="dtj-cs__form" action="{{ routes.cart_add_url }}" method="post">
                        {%- if p_pick -%}
                          <div class="dtj-cs__selectwrap">
                            <select class="dtj-cs__var" name="id" aria-label="{{ product.options | first | escape }}">
                              {%- for v in product.variants limit: 30 -%}
                                <option value="{{ v.id }}"{% if v.id == p_variant.id %} selected{% endif %} data-price="{{ v.price | money }}" data-compare="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money }}{% endif %}" data-off="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}% {{ cs_t_off }}{% endif %}" data-available="{{ v.available }}"{% if v.featured_image != nil %} data-img="{{ v.featured_image | image_url: width: 600 }}" data-srcset="{{ v.featured_image | image_url: width: 300 }} 300w, {{ v.featured_image | image_url: width: 450 }} 450w, {{ v.featured_image | image_url: width: 600 }} 600w, {{ v.featured_image | image_url: width: 800 }} 800w"{% endif %}>{{ v.title | escape }}{% unless v.available %} ({{ cs_t_sold }}){% endunless %}</option>
                              {%- endfor -%}
                            </select>
                            <svg class="dtj-cs__chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
                          </div>
                        {%- else -%}
                          <input type="hidden" name="id" value="{{ p_variant.id }}">
                        {%- endif -%}
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="dtj-cs__add"{% unless p_variant.available %} disabled{% endunless %}><span class="dtj-cs__add-label">{% if p_variant.available %}{{ cs_t_add }}{% else %}{{ cs_t_sold }}{% endif %}</span></button>
                      </form>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
              {%- if bs.arrows != 'none' -%}
                <button type="button" class="dtj-cs__arrow dtj-cs__prev" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg></button>
                <button type="button" class="dtj-cs__arrow dtj-cs__next" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg></button>
              {%- endif -%}
            </div>
            {%- if bs.show_view and c.url != blank -%}
              <p class="dtj-cs__viewrow"><a class="dtj-cs__view" href="{{ c.url }}">{{ cs_t_view }}</a></p>
            {%- endif -%}
            {%- if bs.progress -%}
              <div class="dtj-cs__progress" aria-hidden="true">
                <span class="dtj-cs__count">01 / {% if total < 10 %}0{% endif %}{{ total }}</span>
                <span class="dtj-cs__bar"><i class="dtj-cs__thumb"></i></span>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
        <p class="dtj-cs__status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </dtj-concern-slider>
{%- elsif request.design_mode -%}
  <p style="margin:0;padding:8px 12px;border:1px dashed currentColor;font-size:12px;opacity:.7" {{ block.shopify_attributes }}>DTJ Shop by Concern is empty. Pick one or more collections, one per concern (editor only: shoppers see nothing).</p>
{%- endif -%}
{%- endcapture -%}

{%- render 'dtj-licence', value: app.metafields.dtj.licence.value, content: dtj_content, design_mode: request.design_mode, attributes: block.shopify_attributes -%}

{% schema %}
{"name":"DTJ Shop by Concern","target":"section","stylesheet":"dtj-concern-slider.css","settings":[{"type":"header","content":"Words"},{"type":"text","id":"heading","label":"Heading (first line)","info":"Example: Shop by"},{"type":"text","id":"heading_accent","label":"Heading (second line, in the accent color)","info":"Example: Concern"},{"type":"text","id":"subtext","label":"Line under the heading"},{"type":"select","id":"heading_tag","label":"Heading tag","default":"h2","options":[{"value":"h1","label":"h1"},{"value":"h2","label":"h2"},{"value":"h3","label":"h3"}]},{"type":"collection_list","id":"collections","label":"Collections","limit":8,"info":"Each collection is one choice in the dropdown. One collection = no dropdown."},{"type":"text","id":"concern_1","label":"Dropdown words 1","info":"Empty = the collection's own title."},{"type":"text","id":"concern_2","label":"Dropdown words 2"},{"type":"text","id":"concern_3","label":"Dropdown words 3"},{"type":"text","id":"concern_4","label":"Dropdown words 4"},{"type":"text","id":"concern_5","label":"Dropdown words 5"},{"type":"text","id":"concern_6","label":"Dropdown words 6"},{"type":"range","id":"products_per_concern","label":"Products per concern","min":4,"max":24,"step":1,"default":12},{"type":"header","content":"Product card"},{"type":"checkbox","id":"show_rating","label":"Show the star rating","default":true,"info":"Read from Judge.me or the store's review ratings. A product with no reviews shows no rating."},{"type":"checkbox","id":"demo_ratings","label":"Sample ratings in the theme editor only","default":true,"info":"Clearly marked, never shown to shoppers."},{"type":"checkbox","id":"show_blurb","label":"Show a short line under the title","default":true,"info":"Uses the product's custom.subtitle field when it has one, else the start of its description."},{"type":"range","id":"blurb_length","label":"Short line length","min":30,"max":160,"step":5,"default":90},{"type":"checkbox","id":"show_compare_price","label":"Show the crossed-out old price","default":true},{"type":"checkbox","id":"show_discount","label":"Show the percent-off pill","default":true},{"type":"checkbox","id":"show_variants","label":"Show the option dropdown","default":true,"info":"A product with one option choice shows no dropdown."},{"type":"select","id":"image_ratio","label":"Picture shape","default":"1","options":[{"value":"1","label":"Square"},{"value":"0.8","label":"Portrait 4:5"},{"value":"1.2","label":"Landscape 6:5"}]},{"type":"select","id":"image_fit","label":"Picture fit","default":"cover","options":[{"value":"cover","label":"Fill the box (may crop)"},{"value":"contain","label":"Show the whole picture"}]},{"type":"select","id":"after_add","label":"After Add to Cart","default":"stay","options":[{"value":"stay","label":"Stay here and say Added"},{"value":"cart","label":"Go to the cart"}]},{"type":"header","content":"Slider"},{"type":"range","id":"visible_desktop","label":"Cards in view on desktop","min":2,"max":5,"step":0.5,"default":3.5,"info":"A half card at the edge shows there is more."},{"type":"range","id":"visible_mobile","label":"Cards in view on phones","min":1,"max":2.5,"step":0.5,"default":1.5},{"type":"range","id":"gap","label":"Space between cards","min":8,"max":40,"step":2,"default":16,"unit":"px"},{"type":"range","id":"card_radius","label":"Card corner roundness","min":0,"max":32,"step":2,"default":12,"unit":"px"},{"type":"range","id":"text_column","label":"Width of the left column on desktop","min":20,"max":40,"step":2,"default":28,"unit":"%"},{"type":"range","id":"container_width","label":"Content width","min":800,"max":1800,"step":20,"default":1400,"unit":"px"},{"type":"select","id":"arrows","label":"Arrows","default":"round","options":[{"value":"round","label":"Round"},{"value":"none","label":"None"}]},{"type":"checkbox","id":"fade_edge","label":"Fade the last card out","default":true},{"type":"checkbox","id":"progress","label":"Show the counter and the progress line","default":true},{"type":"select","id":"button_shape","label":"Button shape","default":"pill","options":[{"value":"pill","label":"Pill"},{"value":"rounded","label":"Rounded"},{"value":"square","label":"Square"}]},{"type":"header","content":"Colors and type"},{"type":"color","id":"accent_color","label":"Accent color","info":"Second heading line, progress line, dropdown text. Empty = a soft purple."},{"type":"color","id":"card_bg","label":"Card color","info":"Empty = a pale tint of the accent."},{"type":"color","id":"button_color","label":"Button color","info":"Empty = very dark."},{"type":"color","id":"button_text","label":"Button text color","info":"Empty = white."},{"type":"color","id":"pill_color","label":"Percent-off pill color","info":"Empty = a pale green."},{"type":"color","id":"pill_text","label":"Percent-off pill text color","info":"Empty = dark green."},{"type":"select","id":"heading_font","label":"Heading font","default":"serif","options":[{"value":"theme","label":"Theme heading font"},{"value":"serif","label":"Serif"},{"value":"sans","label":"Sans"}]},{"type":"range","id":"heading_size_desktop","label":"Heading size on desktop","min":24,"max":72,"step":1,"default":48,"unit":"px"},{"type":"range","id":"heading_size_mobile","label":"Heading size on phones","min":20,"max":48,"step":1,"default":32,"unit":"px"},{"type":"text","id":"add_label","label":"Add to cart","info":"Shows Add to Cart when empty."},{"type":"text","id":"added_label","label":"After adding","info":"Shows Added when empty."},{"type":"text","id":"sold_out_label","label":"Sold out","info":"Shows Sold out when empty."},{"type":"text","id":"view_label","label":"View collection button","info":"Shows View Collection when empty."},{"type":"checkbox","id":"show_view","label":"Show the View Collection button","default":true},{"type":"text","id":"off_label","label":"Word after the percent","info":"Shows OFF when empty."},{"type":"text","id":"reviews_label","label":"Word after the review count","info":"Shows reviews when empty."},{"type":"header","content":"Style and spacing"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":2,"unit":"px","default":40},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":2,"unit":"px","default":40},{"type":"range","id":"side_padding","label":"Side space","min":0,"max":64,"step":2,"unit":"px","default":16},{"type":"color","id":"text_color","label":"Text color","info":"Empty = follows the theme."},{"type":"color","id":"background","label":"Background color","info":"Empty = the block's neutral default."}],"javascript":"dtj-concern-slider.js"}
{% endschema %}
