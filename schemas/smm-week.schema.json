{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dtj://schemas/smm-week.schema.json",
  "title": "One week of DTJ social posts (services/smm)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "week",
    "posts"
  ],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^20[0-9]{2}-W[0-5][0-9]$"
    },
    "made_by": {
      "type": "string"
    },
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic",
          "why",
          "source"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "posts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/post"
      }
    }
  },
  "$defs": {
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publish_at",
        "theme",
        "format",
        "proof_ids",
        "media",
        "platforms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^20[0-9]{2}-W[0-5][0-9]-p[0-9]{1,2}$"
        },
        "publish_at": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:00\\+05:30$",
          "description": "India time, e.g. 2026-10-21T19:00:00+05:30"
        },
        "theme": {
          "enum": [
            "client-result",
            "founder-pain",
            "before-after",
            "our-work",
            "tip",
            "founder"
          ]
        },
        "format": {
          "enum": [
            "image",
            "carousel",
            "video",
            "text"
          ]
        },
        "proof_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "alt"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^media/[A-Za-z0-9._-]+$"
              },
              "alt": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1000
              },
              "seconds": {
                "type": "number"
              }
            }
          }
        },
        "overlay_text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "every word the template put on the picture"
        },
        "render": {
          "type": "array",
          "description": "how each picture was made: smm render fills the file and overlay_text from this",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "template"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^media/[A-Za-z0-9._-]+\\.jpg$"
              },
              "template": {
                "type": "string"
              },
              "fields": {
                "type": "object"
              }
            }
          }
        },
        "ai_media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "used": {
              "type": "boolean"
            },
            "what": {
              "type": "string"
            },
            "realistic_person": {
              "type": "boolean"
            },
            "label_on": {
              "type": "boolean",
              "description": "the platform's 'made with AI' label is switched on for this post"
            }
          }
        },
        "explains_jargon": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "platforms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "instagram": {
              "$ref": "#/$defs/captioned"
            },
            "facebook": {
              "$ref": "#/$defs/captioned"
            },
            "linkedin": {
              "$ref": "#/$defs/captioned"
            },
            "x": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "first_media": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "use only the first N files on this platform (e.g. X takes 4 pictures)"
                }
              }
            },
            "youtube": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "description"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "first_media": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "use only the first N files on this platform (e.g. X takes 4 pictures)"
                }
              }
            }
          }
        }
      }
    },
    "captioned": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[A-Za-z0-9_]+$"
          }
        },
        "first_media": {
          "type": "integer",
          "minimum": 1,
          "description": "use only the first N files on this platform (e.g. X takes 4 pictures)"
        }
      }
    }
  }
}
