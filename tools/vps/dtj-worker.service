# DTJ store factory worker (n8n/store-factory/worker.py): takes every request n8n leaves for Claude Code and runs it on the VPS.
# A systemd USER service of the user ai; tools/vps/setup_worker.sh copies it to ~/.config/systemd/user/ and starts it.
# Exit 2 = a key or the spend cap is missing: it does not restart until someone fixes that (tools/vps/README.md).
[Unit]
Description=DTJ store factory worker (n8n requests -> Claude Code on DTJ's Claude API key)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dtj-agency-automation
EnvironmentFile=%h/.config/dtj/worker.env
Environment=PATH=%h/dtj-agency-automation/.venv/bin:%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/dtj-agency-automation/.venv/bin/python n8n/store-factory/worker.py
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
