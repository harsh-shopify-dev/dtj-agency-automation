    {
      "id": "4eb9d4a3-e0ad-49a9-8792-9440451c0f4c",
      "name": "Request for Claude Code: Page Design",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Claude Code designs this page instead of the Claude API (Harsh's choice, 9 Oct 2026: the same hand-off as the dtj content workflow).\n// Claude Code reads \"request\" from this node's output, runs the page builder on Harsh's PC\n// (services/store-builder: python -m page_builder.run_client --intake <this output as JSON> --plan answer --copy answer ...),\n// shows Harsh the plan and the screenshots, then POSTs to resume_url:\n// {\"page_status\": \"ready for approval\" | \"needs a look\" | \"could not build\", \"approve_code\": \"<12 hex, only when ready>\",\n//  \"summary\": \"<the plan in two or three sentences>\", \"sections\": [\"...\"], \"note\": \"<anything Harsh should know>\"}\nconst row = $input.first().json;\nif (!row || !row.id) throw new Error('No brief with that row id in dtj_client_intake');\nreturn [{ json: {\n  claude_code_stage: 'page_design',\n  resume_url: $execution.resumeUrl,\n  request: {\n    row_id: row.id, brand_name: row.brand_name, store_domain: row.store_domain, theme_id: row.theme_id || '',\n    status: row.status, problems: row.problems || '',\n    brand: JSON.parse(row.brand_json || '{}'), facts: JSON.parse(row.facts_json || '{}'),\n    picture_links: JSON.parse(row.picture_links_json || '[]'), logo_link: row.logo_link || '', notes: row.notes || '',\n  },\n} }];"
      }
    },
    {
      "id": "1bbff904-923c-46f1-bd7b-e1965c35c571",
      "name": "Wait for Claude Code: Page Design",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 3,
        "resumeUnit": "days",
        "options": {}
      },
      "webhookId": "2b303f14-cacc-411a-8ee4-c24faad08834"
    },
    {
      "id": "9dd0591a-61b8-4b45-8045-68eaf172588d",
      "name": "Claude Code Reply: Page Design",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reads what Claude Code posted to the Wait node (a timeout resumes with no body) and keeps only well-formed values.\nconst posted = $input.first().json.body;\nconst b = posted && typeof posted === 'object' && !Array.isArray(posted) ? posted : {};\nconst allowed = ['ready for approval', 'needs a look', 'could not build'];\nlet status = allowed.includes(b.page_status) ? b.page_status : (Object.keys(b).length ? 'reply not understood' : 'timed out (no reply in 3 days)');\nconst code = /^[0-9a-f]{12}$/.test(String(b.approve_code || '')) ? String(b.approve_code) : '';\nif (status === 'ready for approval' && !code) status = 'reply not understood (no approval code)';\nreturn [{ json: {\n  row_id: $('Load Brief').first().json.id,\n  page_status: status,\n  approve_code: status === 'ready for approval' ? code : '',\n  page_summary: String(b.summary || ''),\n  page_sections: Array.isArray(b.sections) ? b.sections.map(String).join(', ') : '',\n  page_note: String(b.note || ''),\n} }];"
      }
    },
