      "typeVersion": 1.1,
      "position": [
        1680,
        240
      ],
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 14,
        "resumeUnit": "days",
        "options": {}
      },
      "webhookId": "4822813b-7a1a-454d-a219-8006ee37cb59"
    },
    {
      "id": "a94a3d2d-b643-4950-931b-e02f78e298a7",
      "name": "Claude Code Reply: Write to Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reads what Claude Code posted after the write (a timeout resumes with no body).\nconst posted = $input.first().json.body;\nconst b = posted && typeof posted === 'object' && !Array.isArray(posted) ? posted : {};\nconst allowed = ['written to draft', 'not written'];\nconst result = allowed.includes(b.result) ? b.result : (Object.keys(b).length ? 'reply not understood' : 'timed out (no reply in 14 days)');\nreturn [{ json: {\n  row_id: $('Claude Code Reply: Page Design').first().json.row_id,\n  page_status: result,\n  approved_by: result === 'written to draft' ? String(b.approved_by || '') : '',\n  page_note: String(b.note || ''),\n} }];"
      }
